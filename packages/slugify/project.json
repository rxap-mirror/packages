{
  "name": "slugify",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/slugify/src",
  "projectType": "library",
  "tags": ["packages", "standalone", "scope:utilities"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/slugify",
        "main": "packages/slugify/src/index.ts",
        "tsConfig": "packages/slugify/tsconfig.lib.json",
        "assets": ["packages/slugify/*.md", "packages/slugify/docs"]
      }
    },
    "lint": {
      "options": {
        "lintFilePatterns": ["packages/slugify/**/*.ts"]
      }
    }
  }
}
