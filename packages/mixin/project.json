{
  "name": "mixin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/mixin/src",
  "projectType": "library",
  "tags": ["packages", "standalone", "scope:utilities"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/mixin",
        "main": "packages/mixin/src/index.ts",
        "tsConfig": "packages/mixin/tsconfig.lib.json",
        "assets": ["packages/mixin/*.md", "packages/mixin/docs"]
      }
    },

    "lint": {
      "options": {
        "lintFilePatterns": ["packages/mixin/**/*.ts"]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs mixin {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },

    "test": {
      "options": {
        "jestConfig": "packages/mixin/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    }
  }
}
