{
  "name": "rxap",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/rxap",
  "projectType": "library",
  "tags": ["standalone"],
  "implicitDependencies": [
    "angular-authentication",
    "angular-authorization",
    "angular-bootstrap",
    "angular-changelog",
    "angular-components",
    "angular-config",
    "angular-contenteditable",
    "angular-data-grid",
    "angular-data-source",
    "angular-definition",
    "angular-dialog",
    "angular-directives",
    "angular-environment",
    "angular-error",
    "angular-firebase",
    "angular-form-system",
    "angular-form-window-system",
    "angular-forms",
    "angular-handlebars",
    "angular-icon",
    "angular-keycloak",
    "angular-layout",
    "angular-life-cycle",
    "angular-localize",
    "angular-material-authentication",
    "angular-material-directives",
    "angular-material-form-system",
    "angular-material-localize",
    "angular-material-table-select",
    "angular-material-table-system",
    "angular-material-table-window-system",
    "angular-memory",
    "angular-oauth",
    "angular-open-api",
    "angular-pipes",
    "angular-pub-sub",
    "angular-remote-method",
    "angular-sentry",
    "angular-service-worker",
    "angular-services",
    "angular-socket-io",
    "angular-status-check",
    "angular-table-system",
    "angular-theme",
    "angular-timeago",
    "angular-tree",
    "angular-upload",
    "angular-user",
    "angular-window-system",
    "browser-tailwind",
    "browser-utilities",
    "data-structure-tree",
    "generator-ts-morph",
    "generator-utilities",
    "json-schema-to-typescript",
    "mixin",
    "nest-dto",
    "nest-firebase",
    "nest-jwt",
    "nest-logger",
    "nest-minio",
    "nest-open-api",
    "nest-sentry",
    "nest-server",
    "nest-socket-io-client",
    "nest-supabase",
    "nest-testing",
    "nest-utilities",
    "nest-vault",
    "nest-web3-storage",
    "node-local-storage",
    "node-utilities",
    "open-api-service-app-angular-accordion",
    "open-api-service-app-angular-table",
    "open-api-service-changelog",
    "open-api-service-configuration",
    "open-api-service-status",
    "open-api-service-user",
    "pattern",
    "plugin-angular",
    "plugin-application",
    "plugin-compodoc",
    "plugin-cypress",
    "plugin-docker",
    "plugin-gitlab-ci",
    "plugin-gpt",
    "plugin-library",
    "plugin-localazy",
    "plugin-nestjs",
    "plugin-open-api",
    "plugin-storybook",
    "plugin-utilities",
    "plugin-web3-storage",
    "plugin-workspace",
    "preset-angular",
    "preset-workspace",
    "reflect-metadata",
    "rxjs",
    "schematic-angular",
    "schematic-composer",
    "schematic-nestjs",
    "schematic-open-api",
    "schematic-ts-morph",
    "schematic-utilities",
    "schematic-xml-parser",
    "slugify",
    "ts-morph",
    "utilities",
    "validator",
    "workspace-cypress",
    "workspace-open-api",
    "workspace-ts-morph",
    "workspace-utilities",
    "xml-parser"
  ],
  "targets": {
    "build": {
      "dependsOn": ["readme", "check-version"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "rm -fr dist/packages/rxap",
          "mkdir -p dist/packages/rxap",
          "cp packages/rxap/package.json dist/packages/rxap/package.json",
          "cp packages/rxap/README.md dist/packages/rxap/README.md",
          "cp -r packages/rxap/LICENSE dist/packages/rxap/LICENSE",
          "cp -r packages/rxap/LICENSE.md dist/packages/rxap/LICENSE.md"
        ]
      }
    },
    "readme": {},
    "check-version": {
      "options": {
        "packageName": "nx"
      }
    },
    "update-implicit-dependencies": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["bash ./packages/rxap/update-implicit-dependencies.sh"]
      }
    },
    "update-include-packages": {
      "dependsOn": ["update-implicit-dependencies"],
      "executor": "nx:run-commands",
      "options": {
        "commands": ["bash ./packages/rxap/update-include-packages.sh"]
      }
    },
    "update-package-group": {
      "dependsOn": ["update-include-packages", "update-implicit-dependencies"],
      "options": {
        "includeDependencies": true,
        "include": [
          "@angular/animations",
          "@angular/cdk",
          "@angular/common",
          "@angular/compiler",
          "@angular/core",
          "@angular/fire",
          "@angular/forms",
          "@angular/localize",
          "@angular/material",
          "@angular/platform-browser",
          "@angular/platform-browser-dynamic",
          "@angular/router",
          "@angular/service-worker",
          "@nestjs/axios",
          "@nestjs/cache-manager",
          "@nestjs/common",
          "@nestjs/config",
          "@nestjs/core",
          "@nestjs/jwt",
          "@nestjs/microservices",
          "@nestjs/platform-express",
          "@nestjs/serve-static",
          "@nestjs/swagger",
          "@nestjs/terminus",
          "@nestjs/throttler",
          "@angular/cli",
          "@angular/compiler-cli",
          "@angular/language-service",
          "@nestjs/schematics",
          "@nestjs/testing",
          "@nx/angular",
          "@nx/cypress",
          "@nx/devkit",
          "@nx/eslint",
          "@nx/eslint-plugin",
          "@nx/jest",
          "@nx/js",
          "@nx/nest",
          "@nx/node",
          "@nx/plugin",
          "@nx/storybook",
          "@nx/webpack",
          "nx"
        ]
      }
    },
    "typedoc": {
      "options": {
        "outputPath": ["dist/docs/packages/rxap", "packages/rxap/docs"]
      }
    },
    "linking": {}
  }
}
