{
  "name": "workspace-open-api",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/workspace/open-api/src",
  "projectType": "library",
  "tags": ["packages", "workspace", "scope:utilities"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/workspace/open-api",
        "main": "packages/workspace/open-api/src/index.ts",
        "tsConfig": "packages/workspace/open-api/tsconfig.lib.json",
        "assets": [
          "packages/workspace/open-api/*.md",
          "packages/workspace/open-api/docs"
        ]
      }
    },
    "fix-dependencies": {
      "options": {
        "options": {
          "strict": true,
          "onlyDependencies": true
        },
        "generator": "@rxap/plugin-library:fix-dependencies"
      },
      "executor": "@rxap/plugin-library:run-generator",
      "outputs": ["{projectRoot}/package.json"]
    },
    "index-export": {},
    "lint": {
      "options": {
        "lintFilePatterns": ["packages/workspace/open-api/**/*.ts"]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs workspace-open-api {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },
    "readme": {},
    "test": {
      "options": {
        "jestConfig": "packages/workspace/open-api/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "update-dependencies": {},
    "update-package-group": {},
    "linking": {},
    "typedoc": {
      "options": {
        "outputPath": [
          "dist/docs/packages/workspace/open-api",
          "packages/workspace/open-api/docs"
        ]
      }
    }
  }
}
