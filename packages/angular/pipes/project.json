{
  "name": "angular-pipes",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/pipes/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages", "scope:utilities"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/pipes/ng-package.json",
        "tsConfig": "packages/angular/pipes/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/pipes/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "outputs": ["{workspaceRoot}/coverage/packages/angular/pipes"],
      "options": {
        "tsConfig": "packages/angular/pipes/tsconfig.spec.json",
        "runner": "vitest",
        "setupFiles": ["packages/angular/pipes/src/test-setup.ts"],
        "watch": false,
        "include": ["**/*.spec.ts", "../santization/**/*.spec.ts"],
        "coverageInclude": ["packages/angular/pipes/**/*.ts"],
        "coverageExclude": [
          "**/*.spec.ts",
          "**/test-setup.ts",
          "**/index.ts",
          "**/*.stories.ts",
          "**/.storybook/**",
          "**/prism/**",
          "**/compodoc/**",
          "**/jest.generators.config.ts",
          "**/generators/**",
          "**/schematics/**",
          "**/migrations/**"
        ],
        "coverageThresholds": {
          "lines": 90,
          "statements": 90
        }
      }
    },
    "lint": {
      "options": {
        "lintFilePatterns": [
          "packages/angular/pipes/**/*.ts",
          "packages/angular/pipes/**/*.html",
          "packages/angular/pipes/santization/**/*.ts",
          "packages/angular/pipes/santization/**/*.html"
        ]
      }
    }
  }
}
