{
  "$schema": "../../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../../dist/packages/angular/timeago",
  "lib": {
    "entryFile": "src/index.ts"
  },
  "assets": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE.md",
    "theme.css",
    "compodoc",
    "docs",
    {
      "input": "./packages/angular/timeago/src/generators",
      "glob": "**/!(*.ts",
      "output": "./src/generators"
    },
    {
      "input": "./packages/angular/timeago",
      "glob": "generators.json",
      "output": "."
    }
  ]
}
