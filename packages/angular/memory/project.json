{
  "name": "angular-memory",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/memory/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": [
    "angular",
    "ngx",
    "packages",
    "scope:utilities",
    "angular:standalone"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/memory/ng-package.json",
        "tsConfig": "packages/angular/memory/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/memory/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "outputs": ["{workspaceRoot}/coverage/packages/angular/memory"],
      "options": {
        "tsConfig": "packages/angular/memory/tsconfig.spec.json",
        "runner": "vitest",
        "setupFiles": ["packages/angular/memory/src/test-setup.ts"],
        "watch": false
      }
    }
  }
}
