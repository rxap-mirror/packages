      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/memory/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "packages/angular/memory/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    }
  }
}
