{
  "name": "angular-layout",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/layout/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages", "scope:compose"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/layout/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/layout/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "packages/angular/layout/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "build-tailwind": {},
    "check-ng-package": {},
    "check-version": {
      "options": {
        "packageName": "@angular/core"
      }
    },
    "component-test": {
      "options": {
        "cypressConfig": "packages/angular/layout/cypress.config.ts"
      }
    },
    "fix-dependencies": {
      "options": {
        "options": {
          "onlyDependencies": false,
          "strict": true
        },
        "generator": "@rxap/plugin-library:fix-dependencies"
      },
      "executor": "@rxap/plugin-library:run-generator",
      "outputs": ["{projectRoot}/package.json"]
    },
    "lint": {
      "options": {
        "lintFilePatterns": [
          "packages/angular/layout/**/*.ts",
          "packages/angular/layout/**/*.html"
        ]
      }
    },
    "readme": {},
    "test": {
      "options": {
        "jestConfig": "packages/angular/layout/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "update-dependencies": {},
    "update-package-group": {},
    "linking": {},
    "index-export": {},
    "compodoc": {
      "options": {
        "tsConfig": "packages/angular/layout/tsconfig.compodoc.json",
        "outputPath": [
          "dist/compodoc/packages/angular/layout",
          "packages/angular/layout/compodoc"
        ]
      }
    },
    "typedoc": {
      "options": {
        "outputPath": [
          "dist/docs/packages/angular/layout",
          "packages/angular/layout/docs"
        ]
      }
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "packages/angular/layout/.storybook",
        "browserTarget": "angular:build:development",
        "compodoc": true,
        "compodocArgs": ["-e", "json", "-d", "packages/angular/layout"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/angular-layout",
        "configDir": "packages/angular/layout/.storybook",
        "browserTarget": "angular:build:development",
        "compodoc": true,
        "compodocArgs": ["-e", "json", "-d", "packages/angular/layout"],
        "styles": ["shared/angular/styles/_index.scss"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      },
      "defaultConfiguration": "ci"
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test-storybook -c packages/angular/layout/.storybook --url=http://localhost:4400"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "angular:build:development",
        "staticFilePath": "dist/storybook/angular-layout",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "angular:build:development"
        }
      }
    }
  }
}
