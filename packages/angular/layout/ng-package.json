{
  "$schema": "../../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../../dist/packages/angular/layout",
  "lib": {
    "entryFile": "src/index.ts"
  },
  "assets": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "theme.css",
    "LICENSE.md",
    "compodoc",
    "docs",
    "generators.json",
    "migrations.json",
    {
      "input": "src/generators",
      "glob": "**/!(*.ts|*.js|*.json)",
      "output": "src/generators"
    },
    {
      "input": "./packages/angular/layout/src/migrations",
      "glob": "**/!(*.ts|*.js|*.json)",
      "output": "./src/migrations"
    },
    {
      "input": "src/migrations",
      "glob": "**/!(*.ts|*.js|*.json)",
      "output": "src/migrations"
    }
  ],
  "allowedNonPeerDependencies": [
    "@nx/devkit",
    "@rxap/ts-morph",
    "@rxap/workspace-ts-morph",
    "@rxap/workspace-utilities"
  ]
}
