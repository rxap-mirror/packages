{
  "name": "angular-oauth2-proxy",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/oauth2-proxy/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/oauth2-proxy/ng-package.json",
        "tailwindConfig": "packages/angular/oauth2-proxy/tailwind.config.js"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/oauth2-proxy/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "packages/angular/oauth2-proxy/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/angular/oauth2-proxy/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "index-export": {},
    "update-dependencies": {},
    "fix-dependencies": {
      "options": {
        "options": {
          "strict": true,
          "onlyDependencies": false
        }
      }
    },
    "readme": {},
    "linking": {},
    "update-package-group": {},
    "check-version": {
      "executor": "@rxap/plugin-library:check-version",
      "options": {
        "packageName": "@angular/core"
      }
    },
    "build-tailwind": {
      "executor": "@rxap/plugin-angular:tailwind",
      "configurations": {
        "production": {
          "minify": true
        },
        "development": {}
      }
    },
    "check-ng-package": {
      "executor": "@rxap/plugin-angular:check-ng-package"
    }
  }
}
