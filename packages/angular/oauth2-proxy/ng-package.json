{
  "$schema": "../../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../../dist/packages/angular/oauth2-proxy",
  "lib": {
    "entryFile": "src/index.ts"
  },
  "allowedNonPeerDependencies": ["@nx/devkit"],
  "assets": [
    {
      "input": "./packages/angular/oauth2-proxy/src/generators",
      "glob": "**/!(*.ts",
      "output": "./src/generators"
    },
    {
      "input": "./packages/angular/oauth2-proxy",
      "glob": "generators.json",
      "output": "."
    },
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE.md",
    "theme.css"
  ]
}
