{
  "name": "angular-dialog",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/dialog/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages", "scope:compose"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/angular/dialog/ng-package.json",
        "tsConfig": "packages/angular/dialog/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/dialog/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "outputs": ["{workspaceRoot}/coverage/packages/angular/dialog"],
      "options": {
        "tsConfig": "packages/angular/dialog/tsconfig.spec.json",
        "runner": "vitest",
        "setupFiles": ["packages/angular/dialog/src/test-setup.ts"],
        "exclude": ["generators/**"],
        "watch": false,
        "coverageInclude": ["packages/angular/dialog/**/*.ts"],
        "coverageExclude": [
          "**/*.spec.ts",
          "**/test-setup.ts",
          "**/index.ts",
          "**/*.stories.ts",
          "**/.storybook/**",
          "**/prism/**",
          "**/compodoc/**",
          "**/jest.generators.config.ts",
          "**/generators/**",
          "**/schematics/**",
          "**/migrations/**"
        ],
        "coverageThresholds": {
          "lines": 90,
          "statements": 90
        }
      },
      "dependsOn": ["test-generators"]
    },
    "test-generators": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
      "outputs": [
        "{workspaceRoot}/coverage/packages/angular/dialog/generators"
      ],
      "options": {
        "command": "jest --config jest.generators.config.ts --passWithNoTests",
        "cwd": "packages/angular/dialog"
      }
    },
    "lint": {
      "options": {
        "lintFilePatterns": [
          "packages/angular/dialog/**/*.ts",
          "packages/angular/dialog/**/*.html"
        ]
      }
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "continuous": true,
      "options": {
        "port": 4400,
        "configDir": "packages/angular/dialog/.storybook",
        "browserTarget": "angular-dialog:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      },
      "readyWhen": {
        "port": "{env.SBCONFIG_PORT ?? options.port ?? 9009}",
        "host": "{env.SBCONFIG_HOSTNAME ?? options.host ?? localhost}"
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/packages/angular/dialog",
        "configDir": "packages/angular/dialog/.storybook",
        "browserTarget": "angular-dialog:build-storybook",
        "compodoc": false,
        "styles": ["shared/angular/styles/_index.scss"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test-storybook -c packages/angular/dialog/.storybook --url=http://localhost:4400"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "angular-dialog:build-storybook",
        "staticFilePath": "dist/packages/angular/dialog",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "angular-dialog:build-storybook:ci"
        }
      }
    },
    "prism": {
      "executor": "@ng-prism/core:serve",
      "parallelism": false,
      "options": {
        "entryPoint": "packages/angular/dialog",
        "prismProject": "prism-host",
        "libraryProject": "angular-dialog",
        "libraryImportPath": "@rxap/dialog",
        "port": 4400
      }
    },
    "prism-build": {
      "executor": "@ng-prism/core:build",
      "parallelism": false,
      "outputs": ["{workspaceRoot}/dist/prism/angular-dialog"],
      "options": {
        "entryPoint": "packages/angular/dialog",
        "prismProject": "prism-host",
        "libraryProject": "angular-dialog",
        "libraryImportPath": "@rxap/dialog",
        "outputPath": "dist/prism/angular-dialog"
      }
    },
    "prism-strip": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npx ng-prism-strip dist/packages/angular/dialog",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
