{
  "name": "angular-dialog",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/dialog/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages", "scope:utilities"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/dialog/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/dialog/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "packages/angular/dialog/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "component-test": {
      "options": {
        "cypressConfig": "packages/angular/dialog/cypress.config.ts"
      }
    },
    "lint": {
      "options": {
        "lintFilePatterns": [
          "packages/angular/dialog/**/*.ts",
          "packages/angular/dialog/**/*.html"
        ]
      }
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "packages/angular/dialog/.storybook",
        "browserTarget": "angular-dialog:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": [
        "{options.outputDir}"
      ],
      "options": {
        "outputDir": "dist/packages/angular/dialog",
        "configDir": "packages/angular/dialog/.storybook",
        "browserTarget": "angular-dialog:build-storybook",
        "compodoc": false,
        "styles": [
          "shared/angular/styles/_index.scss"
        ]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test-storybook -c packages/angular/dialog/.storybook --url=http://localhost:4400"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "angular-dialog:build-storybook",
        "staticFilePath": "dist/packages/angular/dialog",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "angular-dialog:build-storybook:ci"
        }
      }
    }
  }
}
