{
  "name": "angular-form-system",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/form-system/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages", "scope:compose"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/form-system/ng-package.json",
        "tailwindConfig": "packages/angular/form-system/tailwind.config.js"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/form-system/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "packages/angular/form-system/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "build-tailwind": {},
    "check-ng-package": {},
    "check-version": {
      "options": {
        "packageName": "@angular/core"
      }
    },
    "fix-dependencies": {
      "options": {
        "options": {
          "strict": true,
          "onlyDependencies": false
        },
        "generator": "@rxap/plugin-library:fix-dependencies"
      },
      "executor": "@rxap/plugin-library:run-generator",
      "outputs": ["{projectRoot}/package.json"]
    },
    "index-export": {},
    "lint": {
      "options": {
        "lintFilePatterns": [
          "packages/angular/form-system/**/*.ts",
          "packages/angular/form-system/**/*.html"
        ]
      }
    },
    "readme": {},
    "test": {
      "options": {
        "jestConfig": "packages/angular/form-system/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "update-dependencies": {},
    "update-package-group": {},
    "linking": {},
    "compodoc": {
      "options": {
        "tsConfig": "packages/angular/form-system/tsconfig.compodoc.json",
        "outputPath": [
          "dist/compodoc/packages/angular/form-system",
          "packages/angular/form-system/compodoc"
        ]
      }
    }
  }
}
