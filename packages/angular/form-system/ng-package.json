{
  "$schema": "../../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../../dist/packages/angular/form-system",
  "lib": {
    "entryFile": "src/index.ts"
  },
  "assets": [
    "README.md",
    "CHANGELOG.md",
    {
      "input": ".",
      "glob": "**/*.theme.scss",
      "output": "."
    },
    {
      "input": ".",
      "glob": "_index.scss",
      "output": "."
    },
    "LICENSE",
    "theme.css",
    "LICENSE.md",
    "compodoc",
    "docs",
    {
      "input": "./packages/angular/form-system/src/generators",
      "glob": "**/!(*.ts",
      "output": "./src/generators"
    },
    {
      "input": "./packages/angular/form-system",
      "glob": "generators.json",
      "output": "."
    }
  ],
  "allowedNonPeerDependencies": ["@nx/devkit"]
}
