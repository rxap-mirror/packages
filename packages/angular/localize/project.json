{
  "name": "angular-localize",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/localize/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages", "scope:compose"],
  "targets": {

    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/localize/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/localize/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "packages/angular/localize/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    }

  }
}
