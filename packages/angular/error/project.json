{
  "name": "angular-error",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/error/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages", "scope:compose"],
  "implicitDependencies": ["angular-error"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/error/ng-package.json",
        "tsConfig": "packages/angular/error/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/error/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "options": {
        "lintFilePatterns": [
          "packages/angular/error/**/*.ts",
          "packages/angular/error/**/*.html"
        ]
      }
    },
    "component-test": {
      "options": {
        "cypressConfig": "packages/angular/error/cypress.config.ts",
        "devServerTarget": "angular-error:build:development"
      },
      "configurations": {
        "open": {}
      }
    },
    "prism": {
      "executor": "@ng-prism/core:serve",
      "parallelism": false,
      "options": {
        "entryPoint": "packages/angular/error",
        "prismProject": "prism-host",
        "libraryProject": "angular-error",
        "libraryImportPath": "@rxap/ngx-error",
        "port": 4400
      }
    },
    "prism-build": {
      "executor": "@ng-prism/core:build",
      "parallelism": false,
      "outputs": ["{workspaceRoot}/dist/prism/angular-error"],
      "options": {
        "entryPoint": "packages/angular/error",
        "prismProject": "prism-host",
        "libraryProject": "angular-error",
        "libraryImportPath": "@rxap/ngx-error",
        "outputPath": "dist/prism/angular-error"
      }
    },
    "prism-strip": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npx ng-prism-strip dist/packages/angular/error",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
