{
  "name": "angular-services",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/services/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages", "scope:utilities"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/services/ng-package.json",
        "tsConfig": "packages/angular/services/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/services/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "outputs": ["{workspaceRoot}/coverage/packages/angular/services"],
      "options": {
        "tsConfig": "packages/angular/services/tsconfig.spec.json",
        "runner": "vitest",
        "setupFiles": ["packages/angular/services/src/test-setup.ts"],
        "exclude": ["generators/**"],
        "watch": false
      },
      "dependsOn": ["test-generators"]
    },
    "test-generators": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
      "outputs": [
        "{workspaceRoot}/coverage/packages/angular/services/generators"
      ],
      "options": {
        "command": "jest --config jest.generators.config.ts --passWithNoTests",
        "cwd": "packages/angular/services"
      }
    },
    "lint": {
      "options": {
        "lintFilePatterns": [
          "packages/angular/services/**/*.ts",
          "packages/angular/services/**/*.html",
          "packages/angular/services/testing/**/*.ts",
          "packages/angular/services/testing/**/*.html"
        ]
      }
    }
  }
}
