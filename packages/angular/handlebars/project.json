{
  "name": "angular-handlebars",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/handlebars/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": [
    "angular",
    "ngx",
    "packages",
    "angular:standalone",
    "scope:integration"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/handlebars/ng-package.json",
        "tsConfig": "packages/angular/handlebars/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/handlebars/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production",
      "dependsOn": ["^build", "build-generators"]
    },
    "build-generators": {
      "executor": "@rxap/plugin-angular:build-generators",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/generators/**/*",
        "{projectRoot}/generators.json",
        "{projectRoot}/tsconfig.generators.json",
        "{projectRoot}/tsconfig.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": ["{projectRoot}/dist/generators"],
      "dependsOn": []
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "outputs": ["{workspaceRoot}/coverage/packages/angular/handlebars"],
      "options": {
        "tsConfig": "packages/angular/handlebars/tsconfig.spec.json",
        "runner": "vitest",
        "setupFiles": ["packages/angular/handlebars/src/test-setup.ts"],
        "watch": false,
        "coverageInclude": ["packages/angular/handlebars/**/*.ts"],
        "coverageExclude": [
          "**/*.spec.ts",
          "**/test-setup.ts",
          "**/index.ts",
          "**/*.stories.ts",
          "**/.storybook/**",
          "**/prism/**",
          "**/compodoc/**",
          "**/jest.generators.config.ts",
          "**/generators/**",
          "**/schematics/**",
          "**/migrations/**"
        ],
        "coverageThresholds": {
          "lines": 90,
          "statements": 90
        }
      }
    },
    "fix-dependencies": {
      "options": {
        "dependencies": ["handlebars"]
      }
    },
    "lint": {
      "options": {
        "lintFilePatterns": [
          "packages/angular/handlebars/**/*.ts",
          "packages/angular/handlebars/**/*.html"
        ]
      }
    }
  }
}
