{
  "$schema": "../../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../../dist/packages/angular/handlebars",
  "lib": {
    "entryFile": "src/index.ts"
  },
  "allowedNonPeerDependencies": ["handlebars", "@nx/devkit"],
  "assets": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "theme.css",
    "LICENSE.md",
    "compodoc",
    "docs",
    {
      "input": "./packages/angular/handlebars/src/generators",
      "glob": "**/!(*.ts|*.js|*.json)",
      "output": "./src/generators"
    },
    {
      "input": "./packages/angular/handlebars",
      "glob": "generators.json",
      "output": "."
    }
  ]
}
