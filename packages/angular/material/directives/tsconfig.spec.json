{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../../dist/out-tsc",
    "module": "preserve",
    "target": "es2016",
    "types": ["vitest/globals", "node", "@angular/localize"],
    "moduleResolution": "bundler"
  },
  "files": ["src/test-setup.ts"],
  "include": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "button/**/*.spec.ts",
    "card/**/*.spec.ts",
    "expansion/**/*.spec.ts",
    "form-field/**/*.spec.ts",
    "icon/**/*.spec.ts",
    "tabs/**/*.spec.ts"
  ],
  "exclude": ["src/generators/**"]
}
