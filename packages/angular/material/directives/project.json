{
  "name": "angular-material-directives",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/material/directives/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages", "material", "scope:utilities"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/angular/material/directives/ng-package.json",
        "tsConfig": "packages/angular/material/directives/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/material/directives/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "outputs": [
        "{workspaceRoot}/coverage/packages/angular/material/directives"
      ],
      "dependsOn": ["test-generators"],
      "options": {
        "tsConfig": "packages/angular/material/directives/tsconfig.spec.json",
        "runner": "vitest",
        "setupFiles": [
          "packages/angular/material/directives/src/test-setup.ts"
        ],
        "exclude": ["generators/**"],
        "watch": false,
        "include": ["**/*.spec.ts", "../*/**/*.spec.ts"],
        "coverageInclude": ["packages/angular/material/directives/**/*.ts"],
        "coverageExclude": [
          "**/*.spec.ts",
          "**/test-setup.ts",
          "**/index.ts",
          "**/*.stories.ts",
          "**/.storybook/**",
          "**/prism/**",
          "**/compodoc/**",
          "**/jest.generators.config.ts",
          "**/generators/**",
          "**/schematics/**",
          "**/migrations/**"
        ],
        "coverageThresholds": {
          "lines": 90,
          "statements": 90
        }
      }
    },
    "test-generators": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
      "outputs": [
        "{workspaceRoot}/coverage/packages/angular/material/directives/generators"
      ],
      "options": {
        "command": "jest --config jest.generators.config.ts --passWithNoTests",
        "cwd": "packages/angular/material/directives"
      }
    },
    "lint": {
      "options": {
        "lintFilePatterns": [
          "packages/angular/material/directives/**/*.ts",
          "packages/angular/material/directives/**/*.html",
          "packages/angular/material/directives/card/**/*.ts",
          "packages/angular/material/directives/card/**/*.html",
          "packages/angular/material/directives/expansion/**/*.ts",
          "packages/angular/material/directives/expansion/**/*.html",
          "packages/angular/material/directives/form-field/**/*.ts",
          "packages/angular/material/directives/form-field/**/*.html",
          "packages/angular/material/directives/icon/**/*.ts",
          "packages/angular/material/directives/icon/**/*.html",
          "packages/angular/material/directives/tabs/**/*.ts",
          "packages/angular/material/directives/tabs/**/*.html",
          "packages/angular/material/directives/button/**/*.ts",
          "packages/angular/material/directives/button/**/*.html"
        ]
      }
    },
    "prism": {
      "executor": "@ng-prism/core:serve",
      "parallelism": false,
      "options": {
        "entryPoint": "packages/angular/material/directives",
        "prismProject": "prism-host",
        "libraryProject": "angular-material-directives",
        "libraryImportPath": "@rxap/material-directives",
        "port": 4400
      }
    },
    "prism-build": {
      "executor": "@ng-prism/core:build",
      "parallelism": false,
      "outputs": ["{workspaceRoot}/dist/prism/angular-material-directives"],
      "options": {
        "entryPoint": "packages/angular/material/directives",
        "prismProject": "prism-host",
        "libraryProject": "angular-material-directives",
        "libraryImportPath": "@rxap/material-directives",
        "outputPath": "dist/prism/angular-material-directives"
      }
    },
    "prism-strip": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npx ng-prism-strip dist/packages/angular/material/directives",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
