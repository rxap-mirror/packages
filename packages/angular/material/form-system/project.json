{
  "name": "angular-material-form-system",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/material/form-system/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages", "material", "scope:compose"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/material/form-system/ng-package.json",
        "tsConfig": "packages/angular/material/form-system/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/material/form-system/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production",
      "dependsOn": ["^build", "build-generators"]
    },
    "build-generators": {
      "executor": "@rxap/plugin-angular:build-generators",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/generators/**/*",
        "{projectRoot}/generators.json",
        "{projectRoot}/tsconfig.generators.json",
        "{projectRoot}/tsconfig.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": ["{projectRoot}/dist/generators"],
      "dependsOn": []
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "outputs": [
        "{workspaceRoot}/coverage/packages/angular/material/form-system"
      ],
      "options": {
        "tsConfig": "packages/angular/material/form-system/tsconfig.spec.json",
        "runner": "vitest",
        "setupFiles": [
          "packages/angular/material/form-system/src/test-setup.ts"
        ],
        "exclude": ["generators/**"],
        "watch": false,
        "coverageInclude": ["packages/angular/material/form-system/**/*.ts"],
        "coverageExclude": [
          "**/*.spec.ts",
          "**/test-setup.ts",
          "**/index.ts",
          "**/*.stories.ts",
          "**/.storybook/**",
          "**/prism/**",
          "**/compodoc/**",
          "**/jest.generators.config.ts",
          "**/generators/**",
          "**/schematics/**",
          "**/migrations/**"
        ],
        "coverageThresholds": {
          "lines": 90,
          "statements": 90
        }
      },
      "dependsOn": ["test-generators"]
    },
    "test-generators": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
      "outputs": [
        "{workspaceRoot}/coverage/packages/angular/material/form-system/generators"
      ],
      "options": {
        "command": "jest --config jest.generators.config.ts --passWithNoTests",
        "cwd": "packages/angular/material/form-system"
      }
    },
    "lint": {
      "options": {
        "lintFilePatterns": [
          "packages/angular/material/form-system/**/*.ts",
          "packages/angular/material/form-system/**/*.html"
        ]
      }
    },
    "prism": {
      "executor": "@ng-prism/core:serve",
      "parallelism": false,
      "options": {
        "entryPoint": "packages/angular/material/form-system",
        "prismProject": "prism-host",
        "libraryProject": "angular-material-form-system",
        "libraryImportPath": "@rxap/material-form-system",
        "port": 4400
      }
    },
    "prism-build": {
      "executor": "@ng-prism/core:build",
      "parallelism": false,
      "outputs": ["{workspaceRoot}/dist/prism/angular-material-form-system"],
      "options": {
        "entryPoint": "packages/angular/material/form-system",
        "prismProject": "prism-host",
        "libraryProject": "angular-material-form-system",
        "libraryImportPath": "@rxap/material-form-system",
        "outputPath": "dist/prism/angular-material-form-system"
      }
    },
    "prism-strip": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npx ng-prism-strip dist/packages/angular/material/form-system",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
