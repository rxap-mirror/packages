{
  "name": "angular-material-table-system",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/material/table-system/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages", "material", "scope:compose"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/material/table-system/ng-package.json",
        "tsConfig": "packages/angular/material/table-system/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/material/table-system/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "options": {
        "lintFilePatterns": [
          "packages/angular/material/table-system/**/*.ts",
          "packages/angular/material/table-system/**/*.html"
        ]
      }
    },
    "prism": {
      "executor": "@ng-prism/core:serve",
      "parallelism": false,
      "options": {
        "entryPoint": "packages/angular/material/table-system",
        "prismProject": "prism-host",
        "libraryProject": "angular-material-table-system",
        "libraryImportPath": "@rxap/material-table-system",
        "port": 4400
      }
    },
    "prism-build": {
      "executor": "@ng-prism/core:build",
      "parallelism": false,
      "outputs": ["{workspaceRoot}/dist/prism/angular-material-table-system"],
      "options": {
        "entryPoint": "packages/angular/material/table-system",
        "prismProject": "prism-host",
        "libraryProject": "angular-material-table-system",
        "libraryImportPath": "@rxap/material-table-system",
        "outputPath": "dist/prism/angular-material-table-system"
      }
    },
    "prism-strip": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npx ng-prism-strip dist/packages/angular/material/table-system",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
