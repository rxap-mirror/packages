{
  "name": "angular-material-authentication",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/material/authentication/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages", "material"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/material/authentication/ng-package.json",
        "tsConfig": "packages/angular/material/authentication/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/material/authentication/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "outputs": [
        "{workspaceRoot}/coverage/packages/angular/material/authentication"
      ],
      "options": {
        "tsConfig": "packages/angular/material/authentication/tsconfig.spec.json",
        "runner": "vitest",
        "setupFiles": [
          "packages/angular/material/authentication/src/test-setup.ts"
        ],
        "exclude": ["generators/**"],
        "watch": false,
        "coverageInclude": ["packages/angular/material/authentication/**/*.ts"],
        "coverageExclude": [
          "**/*.spec.ts",
          "**/test-setup.ts",
          "**/index.ts",
          "**/*.stories.ts",
          "**/.storybook/**",
          "**/prism/**",
          "**/jest.generators.config.ts",
          "**/generators/**",
          "**/schematics/**",
          "**/migrations/**"
        ],
        "coverageThresholds": {
          "lines": 90,
          "statements": 90
        }
      },
      "dependsOn": ["test-generators"]
    },
    "test-generators": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
      "outputs": [
        "{workspaceRoot}/coverage/packages/angular/material/authentication/generators"
      ],
      "options": {
        "command": "jest --config jest.generators.config.ts --passWithNoTests",
        "cwd": "packages/angular/material/authentication"
      }
    },
    "prism": {
      "executor": "@ng-prism/core:serve",
      "parallelism": false,
      "options": {
        "entryPoint": "packages/angular/material/authentication",
        "prismProject": "prism-host",
        "libraryProject": "angular-material-authentication",
        "libraryImportPath": "@rxap/ngx-material-authentication",
        "port": 4400
      }
    },
    "prism-build": {
      "executor": "@ng-prism/core:build",
      "parallelism": false,
      "outputs": ["{workspaceRoot}/dist/prism/angular-material-authentication"],
      "options": {
        "entryPoint": "packages/angular/material/authentication",
        "prismProject": "prism-host",
        "libraryProject": "angular-material-authentication",
        "libraryImportPath": "@rxap/ngx-material-authentication",
        "outputPath": "dist/prism/angular-material-authentication"
      }
    },
    "prism-strip": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npx ng-prism-strip dist/packages/angular/material/authentication",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
