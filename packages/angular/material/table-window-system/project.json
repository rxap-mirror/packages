{
  "name": "angular-material-table-window-system",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/material/table-window-system/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages", "material", "scope:compose"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/material/table-window-system/ng-package.json",
        "tsConfig": "packages/angular/material/table-window-system/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/material/table-window-system/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "outputs": [
        "{workspaceRoot}/coverage/packages/angular/material/table-window-system"
      ],
      "options": {
        "tsConfig": "packages/angular/material/table-window-system/tsconfig.spec.json",
        "runner": "vitest",
        "setupFiles": [
          "packages/angular/material/table-window-system/src/test-setup.ts"
        ],
        "exclude": ["generators/**"],
        "watch": false,
        "coverageInclude": [
          "packages/angular/material/table-window-system/**/*.ts"
        ],
        "coverageExclude": [
          "**/*.spec.ts",
          "**/test-setup.ts",
          "**/index.ts",
          "**/*.stories.ts",
          "**/.storybook/**",
          "**/prism/**",
          "**/jest.generators.config.ts",
          "**/generators/**",
          "**/schematics/**",
          "**/migrations/**"
        ],
        "coverageThresholds": {
          "lines": 90,
          "statements": 90
        }
      },
      "dependsOn": ["test-generators"]
    },
    "test-generators": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
      "outputs": [
        "{workspaceRoot}/coverage/packages/angular/material/table-window-system/generators"
      ],
      "options": {
        "command": "jest --config jest.generators.config.ts --passWithNoTests",
        "cwd": "packages/angular/material/table-window-system"
      }
    },
    "lint": {
      "options": {
        "lintFilePatterns": [
          "packages/angular/material/table-window-system/**/*.ts",
          "packages/angular/material/table-window-system/**/*.html"
        ]
      }
    }
  }
}
