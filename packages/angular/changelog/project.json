{
  "name": "angular-changelog",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/changelog/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages", "scope:compose"],
  "implicitDependencies": ["angular-changelog"],
  "targets": {
    "copy-open-api-sdk": {
      "inputs": ["{workspaceRoot}/packages/open-api/service/changelog/src/lib"],
      "options": {
        "clientSdkProject": "open-api-service-changelog",
        "angular": true,
        "skipDirectives": true,
        "skipDataSources": true
      }
    },
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/changelog/ng-package.json",
        "tsConfig": "packages/angular/changelog/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/changelog/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "component-test": {
      "executor": "@nx/cypress:cypress",
      "options": {
        "cypressConfig": "packages/angular/changelog/cypress.config.ts",
        "testingType": "component",
        "skipServe": true,
        "devServerTarget": "angular:build:development"
      },
      "configurations": {
        "open": {
          "watch": true
        }
      }
    },
    "prism": {
      "executor": "@ng-prism/core:serve",
      "parallelism": false,
      "options": {
        "entryPoint": "packages/angular/changelog",
        "prismProject": "prism-host",
        "libraryProject": "angular-changelog",
        "libraryImportPath": "@rxap/ngx-changelog",
        "port": 4400
      }
    },
    "prism-build": {
      "executor": "@ng-prism/core:build",
      "parallelism": false,
      "outputs": ["{workspaceRoot}/dist/prism/angular-changelog"],
      "options": {
        "entryPoint": "packages/angular/changelog",
        "prismProject": "prism-host",
        "libraryProject": "angular-changelog",
        "libraryImportPath": "@rxap/ngx-changelog",
        "outputPath": "dist/prism/angular-changelog"
      }
    },
    "prism-strip": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npx ng-prism-strip dist/packages/angular/changelog",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
