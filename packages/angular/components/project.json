{
  "name": "angular-components",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/components/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages", "scope:utilities"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/angular/components/ng-package.json",
        "tsConfig": "packages/angular/components/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/components/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "lint": {
      "options": {
        "lintFilePatterns": [
          "packages/angular/components/**/*.ts",
          "packages/angular/components/**/*.html"
        ]
      }
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "continuous": true,
      "options": {
        "port": 4400,
        "configDir": "packages/angular/components/.storybook",
        "browserTarget": "angular-components:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      },
      "readyWhen": {
        "port": "{env.SBCONFIG_PORT ?? options.port ?? 9009}",
        "host": "{env.SBCONFIG_HOSTNAME ?? options.host ?? localhost}"
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/packages/angular/components",
        "configDir": "packages/angular/components/.storybook",
        "browserTarget": "angular-components:build-storybook",
        "compodoc": false,
        "styles": ["shared/angular/styles/_index.scss"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test-storybook -c packages/angular/components/.storybook --url=http://localhost:4400"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "angular-components:build-storybook",
        "staticFilePath": "dist/packages/angular/components",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "angular-components:build-storybook:ci"
        }
      }
    },
    "prism": {
      "executor": "@ng-prism/core:serve",
      "parallelism": false,
      "options": {
        "entryPoint": "packages/angular/components",
        "prismProject": "prism-host",
        "libraryProject": "angular-components",
        "libraryImportPath": "@rxap/components",
        "port": 4400
      }
    },
    "prism-build": {
      "executor": "@ng-prism/core:build",
      "parallelism": false,
      "outputs": ["{workspaceRoot}/dist/prism/angular-components"],
      "options": {
        "entryPoint": "packages/angular/components",
        "prismProject": "prism-host",
        "libraryProject": "angular-components",
        "libraryImportPath": "@rxap/components",
        "outputPath": "dist/prism/angular-components"
      }
    },
    "prism-strip": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npx ng-prism-strip dist/packages/angular/components",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
