{
  "name": "angular-environment",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/environment/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages", "scope:utilities"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/environment/ng-package.json",
        "tsConfig": "packages/angular/environment/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/environment/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "outputs": ["{workspaceRoot}/coverage/packages/angular/environment"],
      "options": {
        "tsConfig": "packages/angular/environment/tsconfig.spec.json",
        "runner": "vitest",
        "setupFiles": ["packages/angular/environment/src/test-setup.ts"],
        "watch": false
      }
    },
    "lint": {
      "options": {
        "lintFilePatterns": [
          "packages/angular/environment/**/*.ts",
          "packages/angular/environment/**/*.html"
        ]
      }
    },
    "prism": {
      "executor": "@ng-prism/core:serve",
      "parallelism": false,
      "options": {
        "entryPoint": "packages/angular/environment",
        "prismProject": "prism-host",
        "libraryProject": "angular-environment",
        "libraryImportPath": "@rxap/environment",
        "port": 4400
      }
    },
    "prism-build": {
      "executor": "@ng-prism/core:build",
      "parallelism": false,
      "outputs": ["{workspaceRoot}/dist/prism/angular-environment"],
      "options": {
        "entryPoint": "packages/angular/environment",
        "prismProject": "prism-host",
        "libraryProject": "angular-environment",
        "libraryImportPath": "@rxap/environment",
        "outputPath": "dist/prism/angular-environment"
      }
    },
    "prism-strip": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npx ng-prism-strip dist/packages/angular/environment",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
