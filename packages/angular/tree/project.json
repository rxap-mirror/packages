{
  "name": "angular-tree",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/tree/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages", "scope:compose"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/tree/ng-package.json",
        "tsConfig": "packages/angular/tree/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/tree/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production",
      "dependsOn": ["^build", "build-generators"]
    },
    "build-generators": {
      "executor": "@rxap/plugin-angular:build-generators",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/generators/**/*",
        "{projectRoot}/generators.json",
        "{projectRoot}/tsconfig.generators.json",
        "{projectRoot}/tsconfig.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": ["{projectRoot}/dist/generators"],
      "dependsOn": []
    },
    "lint": {
      "options": {
        "lintFilePatterns": [
          "packages/angular/tree/**/*.ts",
          "packages/angular/tree/**/*.html"
        ]
      }
    },
    "prism": {
      "executor": "@ng-prism/core:serve",
      "parallelism": false,
      "options": {
        "entryPoint": "packages/angular/tree",
        "prismProject": "prism-host",
        "libraryProject": "angular-tree",
        "libraryImportPath": "@rxap/tree",
        "port": 4400
      }
    },
    "prism-build": {
      "executor": "@ng-prism/core:build",
      "parallelism": false,
      "outputs": ["{workspaceRoot}/dist/prism/angular-tree"],
      "options": {
        "entryPoint": "packages/angular/tree",
        "prismProject": "prism-host",
        "libraryProject": "angular-tree",
        "libraryImportPath": "@rxap/tree",
        "outputPath": "dist/prism/angular-tree"
      }
    },
    "prism-strip": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "ng-prism-strip dist/packages/angular/tree",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
