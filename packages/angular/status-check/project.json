{
  "name": "angular-status-check",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/status-check/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages", "scope:compose"],
  "targets": {
    "copy-open-api-sdk": {
      "inputs": ["{workspaceRoot}/packages/open-api/service/status/src/lib"],
      "options": {
        "clientSdkProject": "open-api-service-status",
        "angular": true,
        "skipDirectives": true,
        "skipDataSources": true
      }
    },
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/status-check/ng-package.json",
        "tailwindConfig": "packages/angular/status-check/tailwind.config.js"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/status-check/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "packages/angular/status-check/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "build-tailwind": {},
    "check-ng-package": {},
    "check-version": {
      "options": {
        "packageName": "@angular/core"
      }
    },
    "component-test": {
      "options": {
        "cypressConfig": "packages/angular/status-check/cypress.config.ts"
      }
    },
    "fix-dependencies": {
      "options": {
        "options": {
          "strict": true,
          "onlyDependencies": false
        },
        "generator": "@rxap/plugin-library:fix-dependencies"
      },
      "executor": "@rxap/plugin-library:run-generator",
      "outputs": ["{projectRoot}/package.json"]
    },
    "index-export": {},
    "lint": {
      "options": {
        "lintFilePatterns": [
          "packages/angular/status-check/**/*.ts",
          "packages/angular/status-check/**/*.html"
        ]
      }
    },
    "readme": {},
    "test": {
      "options": {
        "jestConfig": "packages/angular/status-check/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "update-dependencies": {},
    "update-package-group": {},
    "linking": {},
    "compodoc": {
      "options": {
        "tsConfig": "packages/angular/status-check/tsconfig.compodoc.json",
        "outputPath": "dist/compodoc/packages/angular/status-check"
      }
    }
  }
}
