{
  "name": "angular-theme",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/theme/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages", "scope:compose"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/theme/ng-package.json",
        "tsConfig": "packages/angular/theme/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/theme/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "outputs": ["{workspaceRoot}/coverage/packages/angular/theme"],
      "options": {
        "tsConfig": "packages/angular/theme/tsconfig.spec.json",
        "runner": "vitest",
        "setupFiles": ["packages/angular/theme/src/test-setup.ts"],
        "exclude": ["generators/**"],
        "watch": false
      },
      "dependsOn": ["test-generators"]
    },
    "test-generators": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
      "outputs": ["{workspaceRoot}/coverage/packages/angular/theme/generators"],
      "options": {
        "command": "jest --config jest.generators.config.ts --passWithNoTests",
        "cwd": "packages/angular/theme"
      }
    }
  }
}
