{
  "name": "angular-pub-sub",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/pub-sub/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": [
    "angular",
    "ngx",
    "packages",
    "angular:standalone",
    "scope:utilities"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/pub-sub/ng-package.json",
        "tsConfig": "packages/angular/pub-sub/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/pub-sub/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "outputs": ["{workspaceRoot}/coverage/packages/angular/pub-sub"],
      "options": {
        "tsConfig": "packages/angular/pub-sub/tsconfig.spec.json",
        "runner": "vitest",
        "setupFiles": ["packages/angular/pub-sub/src/test-setup.ts"],
        "watch": false,
        "coverageInclude": ["packages/angular/pub-sub/**/*.ts"],
        "coverageExclude": [
          "**/*.spec.ts",
          "**/test-setup.ts",
          "**/index.ts",
          "**/*.stories.ts",
          "**/.storybook/**",
          "**/prism/**",
          "**/compodoc/**",
          "**/jest.generators.config.ts",
          "**/generators/**",
          "**/schematics/**",
          "**/migrations/**"
        ],
        "coverageThresholds": {
          "lines": 90,
          "statements": 90
        }
      }
    }
  }
}
