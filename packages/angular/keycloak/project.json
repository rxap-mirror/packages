{
  "name": "angular-keycloak",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/keycloak/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": [
    "angular",
    "ngx",
    "packages",
    "scope:integration",
    "angular:standalone"
  ],
  "targets": {

    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/keycloak/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/keycloak/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "packages/angular/keycloak/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "build-tailwind": {},



    "lint": {
      "options": {
        "lintFilePatterns": [
          "packages/angular/keycloak/**/*.ts",
          "packages/angular/keycloak/**/*.html"
        ]
      }
    },

    "test": {
      "options": {
        "jestConfig": "packages/angular/keycloak/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    }
  }
}
