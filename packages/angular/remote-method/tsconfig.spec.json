{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "module": "preserve",
    "target": "es2016",
    "types": ["vitest/globals", "node", "@angular/localize"],
    "moduleResolution": "bundler"
  },
  "files": ["src/test-setup.ts"],
  "include": [
    "src/**/*.d.ts",
    "directive/**/*.spec.ts",
    "http/directive/**/*.spec.ts",
    "http/**/*.spec.ts",
    "testing/**/*.spec.ts",
    "**/*.spec.ts",
    "**/*.test.ts"
  ],
  "exclude": ["node_modules/**", "src/generators/**"]
}
