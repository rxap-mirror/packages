{
  "name": "angular-service-worker",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/service-worker/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages", "scope:integration"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/service-worker/ng-package.json",
        "tsConfig": "packages/angular/service-worker/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/service-worker/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "outputs": ["{workspaceRoot}/coverage/packages/angular/service-worker"],
      "options": {
        "tsConfig": "packages/angular/service-worker/tsconfig.spec.json",
        "runner": "vitest",
        "setupFiles": ["packages/angular/service-worker/src/test-setup.ts"],
        "exclude": ["generators/**"],
        "watch": false
      },
      "dependsOn": ["test-generators"]
    },
    "test-generators": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
      "outputs": [
        "{workspaceRoot}/coverage/packages/angular/service-worker/generators"
      ],
      "options": {
        "command": "jest --config jest.generators.config.ts --passWithNoTests",
        "cwd": "packages/angular/service-worker"
      }
    },
    "lint": {
      "options": {
        "lintFilePatterns": [
          "packages/angular/service-worker/**/*.ts",
          "packages/angular/service-worker/**/*.html"
        ]
      }
    },
    "prism": {
      "executor": "@ng-prism/core:serve",
      "parallelism": false,
      "options": {
        "entryPoint": "packages/angular/service-worker",
        "prismProject": "prism-host",
        "libraryProject": "angular-service-worker",
        "libraryImportPath": "@rxap/service-worker",
        "port": 4400
      }
    },
    "prism-build": {
      "executor": "@ng-prism/core:build",
      "parallelism": false,
      "outputs": ["{workspaceRoot}/dist/prism/angular-service-worker"],
      "options": {
        "entryPoint": "packages/angular/service-worker",
        "prismProject": "prism-host",
        "libraryProject": "angular-service-worker",
        "libraryImportPath": "@rxap/service-worker",
        "outputPath": "dist/prism/angular-service-worker"
      }
    },
    "prism-strip": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npx ng-prism-strip dist/packages/angular/service-worker",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
