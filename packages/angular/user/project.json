{
  "name": "angular-user",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/user/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages", "scope:compose"],
  "targets": {
    "copy-open-api-sdk": {
      "inputs": ["{workspaceRoot}/packages/open-api/service/user/src/lib"],
      "options": {
        "clientSdkProject": "open-api-service-user",
        "angular": true,
        "skipDirectives": true,
        "skipDataSources": true
      }
    },
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/user/ng-package.json",
        "tsConfig": "packages/angular/user/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/user/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production",
      "dependsOn": ["^build", "build-generators"]
    },
    "build-generators": {
      "executor": "@rxap/plugin-angular:build-generators",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/generators/**/*",
        "{projectRoot}/generators.json",
        "{projectRoot}/tsconfig.generators.json",
        "{projectRoot}/tsconfig.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": ["{projectRoot}/dist/generators"],
      "dependsOn": []
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "outputs": ["{workspaceRoot}/coverage/packages/angular/user"],
      "options": {
        "tsConfig": "packages/angular/user/tsconfig.spec.json",
        "runner": "vitest",
        "setupFiles": ["packages/angular/user/src/test-setup.ts"],
        "exclude": ["generators/**"],
        "watch": false,
        "coverageInclude": ["packages/angular/user/**/*.ts"],
        "coverageExclude": [
          "**/*.spec.ts",
          "**/test-setup.ts",
          "**/index.ts",
          "**/*.stories.ts",
          "**/.storybook/**",
          "**/prism/**",
          "**/compodoc/**",
          "**/jest.generators.config.ts",
          "**/generators/**",
          "**/schematics/**",
          "**/migrations/**"
        ],
        "coverageThresholds": {
          "lines": 90,
          "statements": 90
        }
      },
      "dependsOn": ["test-generators"]
    },
    "test-generators": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
      "outputs": ["{workspaceRoot}/coverage/packages/angular/user/generators"],
      "options": {
        "command": "jest --config jest.generators.config.ts --passWithNoTests",
        "cwd": "packages/angular/user"
      }
    }
  }
}
