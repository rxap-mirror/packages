{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "module": "preserve",
    "target": "es2016",
    "esModuleInterop": true,
    "types": ["vitest/globals", "node", "@angular/localize"],
    "moduleResolution": "bundler"
  },
  "files": ["src/test-setup.ts"],
  "include": ["src/**/*.test.ts", "src/**/*.spec.ts", "src/**/*.d.ts"],
  "exclude": ["src/generators/**"]
}
