{
  "name": "angular-marker-io",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/marker-io/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/marker-io/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/marker-io/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "packages/angular/marker-io/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    }
  }
}
