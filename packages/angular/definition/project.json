{
  "name": "angular-definition",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/definition/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages", "scope:utilities"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/definition/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/definition/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "packages/angular/definition/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },




    "lint": {
      "options": {
        "lintFilePatterns": [
          "packages/angular/definition/**/*.ts",
          "packages/angular/definition/**/*.html"
        ]
      }
    }


  }
}
