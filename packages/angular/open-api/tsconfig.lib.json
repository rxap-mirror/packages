{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": ["@angular/localize"]
  },
  "exclude": [
    "**/*.spec.ts",
    "test-setup.ts",
    "jest.config.ts",
    "**/*.test.ts"
  ],
  "include": [
    "**/*.ts",
    "data-source/**/*.ts",
    "data-source/table/**/*.ts",
    "remote-method/**/*.ts"
  ]
}
