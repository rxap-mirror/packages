{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "module": "preserve",
    "target": "es2016",
    "types": ["vitest/globals", "node", "@angular/localize"],
    "moduleResolution": "bundler"
  },
  "files": ["src/test-setup.ts"],
  "include": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "data-source/**/*.spec.ts",
    "data-source/table/**/*.spec.ts",
    "remote-method/**/*.spec.ts"
  ],
  "exclude": ["src/generators/**"]
}
