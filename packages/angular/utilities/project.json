{
  "name": "angular-utilities",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/utilities/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/angular/utilities/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/utilities/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "packages/angular/utilities/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/angular/utilities/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
