{
  "name": "angular-utilities",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/utilities/src",
  "prefix": "rxap",
  "projectType": "library",
  "tags": ["angular", "ngx", "packages"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/angular/utilities/ng-package.json",
        "tsConfig": "packages/angular/utilities/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/utilities/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "outputs": ["{workspaceRoot}/coverage/packages/angular/utilities"],
      "options": {
        "tsConfig": "packages/angular/utilities/tsconfig.spec.json",
        "runner": "vitest",
        "setupFiles": ["packages/angular/utilities/src/test-setup.ts"],
        "watch": false,
        "coverageInclude": ["packages/angular/utilities/**/*.ts"],
        "coverageExclude": [
          "**/*.spec.ts",
          "**/test-setup.ts",
          "**/index.ts",
          "**/*.stories.ts",
          "**/.storybook/**",
          "**/prism/**",
          "**/compodoc/**",
          "**/jest.generators.config.ts",
          "**/generators/**",
          "**/schematics/**",
          "**/migrations/**"
        ],
        "coverageThresholds": {
          "lines": 90,
          "statements": 90
        }
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
