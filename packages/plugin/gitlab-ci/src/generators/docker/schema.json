{
  "$schema": "http://json-schema.org/schema",
  "$id": "Docker",
  "title": "",
  "type": "object",
  "properties": {
    "gcp": {
      "type": "boolean",
      "description": "Generate docker startup test with pull target to GCP registry"
    },
    "gitlab": {
      "type": "boolean",
      "description": "Generate docker startup test with pull target to gitlab registry"
    },
    "overwrite": {
      "type": "boolean",
      "description": "Overwrite existing files"
    },
    "skipFormat": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "alias": "tag",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": []
}
