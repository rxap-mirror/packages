{
  "name": "plugin-utilities",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/plugin/utilities/src",
  "projectType": "library",
  "tags": ["packages", "plugin", "scope:utilities"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/plugin/utilities",
        "main": "packages/plugin/utilities/src/index.ts",
        "tsConfig": "packages/plugin/utilities/tsconfig.lib.json",
        "assets": ["packages/plugin/utilities/*.md"]
      }
    },
    "check-version": {
      "options": {
        "packageName": "nx"
      }
    },
    "fix-dependencies": {
      "options": {
        "options": {
          "strict": true,
          "onlyDependencies": true
        },
        "generator": "@rxap/plugin-library:fix-dependencies"
      },
      "executor": "@rxap/plugin-library:run-generator",
      "outputs": ["{projectRoot}/package.json"]
    },
    "lint": {
      "options": {
        "lintFilePatterns": ["packages/plugin/utilities/**/*.ts"]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs plugin-utilities {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },
    "readme": {},
    "test": {
      "options": {
        "jestConfig": "packages/plugin/utilities/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "typedoc": {
      "executor": "@enio.ai/typedoc:typedoc",
      "outputs": ["{workspaceRoot}/docs/packages/plugin/utilities"],
      "options": {
        "options": "typedoc.json"
      }
    },
    "update-dependencies": {},
    "update-package-group": {},
    "linking": {},
    "expose-as-schematic": {
      "executor": "@rxap/plugin-library:run-generator",
      "options": {
        "generator": "@rxap/plugin-library:expose-as-schematic"
      }
    }
  }
}
