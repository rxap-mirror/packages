{
  "$schema": "http://json-schema.org/schema",
  "$id": "Init",
  "title": "",
  "type": "object",
  "properties": {
    "packages": {
      "type": "boolean",
      "description": "If true, the workspace will be initialized for package development.",
      "x-prompt": "Has this workspace publishable packages?",
      "default": false,
      "examples": [
        true,
        false
      ]
    },
    "fullStack": {
      "type": "boolean",
      "description": "If true, the workspace will be initialized for full stack application development.",
      "x-prompt": "Is this workspace a full stack application?",
      "default": false,
      "examples": [
        true,
        false
      ]
    },
    "standalone": {
      "type": "boolean",
      "description": "If true, the workspace will be initialized for standalone development.",
      "x-prompt": "Is this a standalone workspace?",
      "default": false,
      "examples": [
        true,
        false
      ]
    },
    "overwrite": {
      "type": "boolean",
      "default": false,
      "description": "Whether to overwrite existing files.",
      "examples": [
        true,
        false
      ]
    },
    "skipFormat": {
      "type": "boolean",
      "default": false,
      "description": "Whether to skip formatting generated files.",
      "examples": [
        true,
        false
      ]
    },
    "skipProjects": {
      "type": "boolean",
      "default": false,
      "description": "Whether to skip executing project specific initialization.",
      "examples": [
        true,
        false
      ]
    },
    "skipLicense": {
      "type": "boolean",
      "default": false,
      "description": "Whether to skip adding a license file.",
      "examples": [
        true,
        false
      ]
    },
    "license": {
      "type": "string",
      "default": "gpl",
      "enum": [
        "none",
        "mit",
        "gpl"
      ],
      "x-prompt": "Which license does this project has?",
      "examples": [
        "mit",
        "gpl",
        "none"
      ]
    },
    "repositoryUrl": {
      "type": "string",
      "description": "The URL of the repository.",
      "examples": [
        "https://github.com/my-org/my-repo"
      ]
    },
    "withHusky": {
      "type": "boolean",
      "description": "Whether to initialize the workspace with Husky.",
      "examples": [
        true,
        false
      ]
    }
  },
  "required": []
}
