{
  "$schema": "http://json-schema.org/schema",
  "$id": "FixImplicitInternalDependencies",
  "title": "",
  "type": "object",
  "properties": {
    "projects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "A list of projects to fix implicit internal dependencies for.",
      "examples": [
        [
          "app1",
          "lib1"
        ]
      ]
    },
    "project": {
      "type": "string",
      "description": "The name of the project to fix implicit internal dependencies for.",
      "examples": [
        "my-app"
      ]
    }
  }
}
