{
  "$schema": "http://json-schema.org/schema",
  "$id": "DockerCompose",
  "title": "",
  "type": "object",
  "properties": {
    "tags": {
      "alias": "tag",
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The tags a project needs to be used to generate docker compose service.",
      "examples": [
        [
          "app",
          "api"
        ]
      ]
    },
    "ignoreProjects": {
      "alias": "ignoreProject",
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The projects to ignore when generating docker compose service.",
      "examples": [
        [
          "ignore-me"
        ]
      ]
    },
    "skipFormat": {
      "type": "boolean",
      "default": false,
      "description": "Whether to skip formatting generated files.",
      "examples": [
        true,
        false
      ]
    },
    "serviceEnvironments": {
      "alias": "serviceEnvironment",
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The environment variables to be used in docker compose service.",
      "examples": [
        [
          "NODE_ENV=production",
          "PORT=3000"
        ]
      ]
    },
    "rootDomain": {
      "type": "string",
      "description": "The root domain to be used in docker compose service.",
      "examples": [
        "example.com"
      ]
    },
    "middlewares": {
      "alias": "middleware",
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The traefik middlewares to be add to each service.",
      "examples": [
        [
          "auth",
          "compress"
        ]
      ]
    },
    "subjectAltNames": {
      "alias": "subjectAltName",
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The subject alt names to be used in the ssl certificate generation.",
      "examples": [
        [
          "*.example.com",
          "api.example.com"
        ]
      ]
    }
  },
  "required": []
}
