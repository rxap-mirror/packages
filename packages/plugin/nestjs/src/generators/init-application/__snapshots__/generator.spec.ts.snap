  "api/schematic.yaml": "package: "@rxap/plugin-nestjs"
name: init-application
options:
  standalone: true
  port: 3000
  sentry: false
  swagger: false
  healthIndicator: false
  validator: false
  jwt: false
  openApi: false
  platform: express
