exports[`plugin-nestjs:init-application (golden master) should produce a stable standalone init-application tree (features off): init-application-tree 1`] = `
{
  ".eslintignore": "node_modules
",
  ".eslintrc.json": "{
  "root": true,
  "ignorePatterns": [
    "**/*"
  ],
