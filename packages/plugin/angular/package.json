{
  "version": "20.3.0-dev.2",
  "name": "@rxap/plugin-angular",
  "description": "This package provides generators and executors for Angular projects within an Nx workspace. It helps initialize and configure Angular applications and libraries with Rxap-specific defaults and utilities. It also includes executors for tasks like checking ng-package configurations, managing application configurations, and generating i18n files.\n",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@nx/angular": "20.5.0",
    "@nx/devkit": "20.5.0",
    "@rxap/plugin-application": "^20.1.0-dev.2",
    "@rxap/plugin-library": "^20.3.0-dev.2",
    "@rxap/plugin-utilities": "^20.0.5-dev.3",
    "@rxap/ts-morph": "^1.6.0-dev.3",
    "@rxap/utilities": "^16.5.0-dev.1",
    "@rxap/workspace-ts-morph": "^19.1.13-dev.4",
    "@rxap/workspace-utilities": "^19.8.1-dev.3",
    "colors": "1.4.0",
    "handlebars": "4.7.8",
    "semver": "7.5.3",
    "tailwindcss": "^3.4.4",
    "ts-morph": "18.0.0",
    "tslib": "2.6.2",
    "yaml": "2.3.1"
  },
  "author": {
    "name": "Merzough Münker",
    "email": "mmuenker@digitaix.com"
  },
  "bugs": {
    "url": "https://gitlab.com/rxap/packages/-/issues",
    "email": "incoming+rxap-packages-14898188-issue-@incoming.gitlab.com"
  },
  "executors": "./executors.json",
  "generators": "./generators.json",
  "homepage": "https:/gitlab.com/rxap/packages/packages/plugin/angular",
  "keywords": [
    "angular",
    "nx",
    "nx-plugin",
    "packages",
    "plugin",
    "plugin-angular",
    "rxap"
  ],
  "ng-update": {
    "requirements": {},
    "migrations": "./migrations.json"
  },
  "publishConfig": {
    "access": "public",
    "directory": "../../../dist/packages/plugin/angular"
  },
  "repository": {
    "type": "git",
