{
  "$schema": "http://json-schema.org/schema",
  "$id": "FixSchematic",
  "title": "",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "description": "The name of the project to fix schematics for.",
      "alias": "p",
      "$default": {
        "$source": "projectName"
      },
      "x-prompt": "What is the name of the project for the schematic?",
      "x-priority": "important",
      "examples": [
        "my-lib"
      ]
    }
  },
  "required": [
    "project"
  ]
}
