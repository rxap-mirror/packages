      "path": "./tsconfig.spec.json"
    }
  ]
}
",
  "feat/tsconfig.lib.json": "{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": [
      "@angular/localize"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "jest.config.ts",
    "jest.config.cts",
    "src/test-setup.ts"
  ]
}
",
  "feat/tsconfig.spec.json": "{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist/out-tsc",
    "module": "commonjs",
    "target": "es2016",
    "types": [
      "jest",
      "node",
      "@angular/localize"
    ],
    "moduleResolution": "node10"
  },
  "files": [
    "src/test-setup.ts"
  ],
  "include": [
    "jest.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}
",
  "jest.config.ts": "import type { Config } from 'jest';
import { getJestProjectsAsync } from '@nx/jest';

export default async (): Promise<Config> => ({
  projects: await getJestProjectsAsync()
});",
  "jest.preset.js": "const nxPreset = require('@nx/jest/preset').default;

module.exports = { ...nxPreset };",
  "nx.json": "{
  "affected": {
    "defaultBase": "main"
