{
  "$schema": "http://json-schema.org/schema",
  "$id": "InitApplication",
  "title": "",
  "type": "object",
  "properties": {
    "project": {
      "type": "string"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "incrementalBuild": {
      "type": "boolean",
      "description": "Whether to enable incremental build"
    },
    "moduleFederation": {
      "alias": "mfe",
      "type": "string",
      "enum": ["host", "remote"]
    },
    "layoutRoutePath": {
      "type": "string",
      "description": "Route path for layout children"
    },
    "standaloneImport": {
      "type": "boolean",
      "description": "Whether to import the mfe remote as a standalone import"
    },
    "skipDocker": {
      "type": "boolean",
      "description": "Whether to skip the docker configuration"
    },
    "host": {
      "type": "string",
      "description": "Host project for module federation"
    },
    "deploy": {
      "type": "string",
      "description": "Add target to deploy to after build",
      "enum": ["web3-storage"]
    },
    "sentry": {
      "type": "boolean",
      "default": true,
      "x-prompt": "Would you like to enable Sentry?"
    },
    "apiStatusCheck": {
      "type": "boolean",
      "default": false
    },
    "authentication": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["oauth2-proxy"],
          "description": "Authentication provider"
        },
        {
          "type": "boolean",
          "description": "Whether to enable authentication"
        }
      ]
    },
    "openApi": {
      "alias": "open-api",
      "type": "boolean",
      "default": false,
      "description": "Whether to enable OpenAPI",
      "x-prompt": "Would you like to enable OpenAPI?"
    },
    "openApiLegacy": {
      "type": "boolean"
    },
    "config": {
      "type": "boolean",
      "default": true,
      "description": "Whether to enable configuration",
      "x-prompt": "Would you like to enable configuration?"
    },
    "localazy": {
      "type": "boolean",
      "default": false,
      "description": "Whether to enable Localazy",
      "x-prompt": "Would you like to enable Localazy?"
    },
    "i18n": {
      "type": "boolean",
      "default": false,
      "description": "Whether to enable i18n",
      "x-prompt": "Would you like to enable i18n?"
    },
    "serviceWorker": {
      "alias": "sw",
      "type": "boolean",
      "default": true,
      "description": "Whether to enable service worker",
      "x-prompt": "Would you like to enable service worker?"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "material": {
      "type": "boolean",
      "default": true,
      "description": "Whether to enable Angular Material",
      "x-prompt": "Would you like to enable Angular Material?"
    },
    "generateMain": {
      "alias": "gm",
      "type": "boolean",
      "description": "Whether to generate the main file"
    },
    "overwrite": {
      "type": "boolean",
      "description": "Whether to overwrite existing files"
    },
    "cleanup": {
      "type": "boolean",
      "description": "Whether to cleanup files",
      "default": true
    },
    "i18nStandalone": {
      "type": "boolean",
      "default": false,
      "description": "Whether to compile each language into a separate application"
    },
    "monolithic": {
      "type": "boolean",
      "description": "Whether to generate a monolithic application",
      "default": true,
      "x-prompt": "Would you like to generate a monolithic application?"
    },
    "localazyReadKey": {
      "type": "string",
      "description": "Localazy read key"
    },
    "authentik": {
      "type": "boolean",
      "description": "Use authentik for authentication"
    },
    "oauth": {
      "type": "boolean",
      "description": "Use OAuth for authentication"
    },
    "skipProjects": {
      "type": "boolean",
      "description": "Whether to skip executing project specific initialization"
    },
    "skipFormat": {
      "type": "boolean"
    },
    "coerce": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {

          }
        }
      ]
    }
  },
  "required": []
}
