{
  "$schema": "http://json-schema.org/schema",
  "$id": "InitApplication",
  "title": "",
  "type": "object",
  "properties": {
    "project": {
      "type": "string"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "incrementalBuild": {
      "type": "boolean",
      "description": "Whether to enable incremental build"
    },
    "moduleFederation": {
      "alias": "mfe",
      "type": "string",
      "enum": ["host", "remote"]
    },
    "layoutRoutePath": {
      "type": "string",
      "description": "Route path for layout children"
    },
    "standaloneImport": {
      "type": "boolean",
      "description": "Whether to import the mfe remote as a standalone import"
    },
    "skipDocker": {
      "type": "boolean",
      "description": "Whether to skip the docker configuration"
    },
    "host": {
      "type": "string",
      "description": "Host project for module federation"
    },
    "deploy": {
      "type": "string",
      "description": "Add target to deploy to after build",
      "enum": ["web3-storage"]
    },
    "sentry": {
      "type": "boolean"
    },
    "authentication": {
      "type": "boolean"
    },
    "openApi": {
      "alias": "open-api",
      "type": "boolean"
    },
    "openApiLegacy": {
      "type": "boolean"
    },
    "config": {
      "type": "boolean"
    },
    "localazy": {
      "type": "boolean"
    },
    "i18n": {
      "type": "boolean"
    },
    "serviceWorker": {
      "alias": "sw",
      "type": "boolean"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "material": {
      "type": "boolean"
    },
    "generateMain": {
      "alias": "gm",
      "type": "boolean"
    },
    "overwrite": {
      "type": "boolean",
      "description": "Whether to overwrite existing files"
    },
    "cleanup": {
      "type": "boolean",
      "description": "Whether to cleanup files"
    },
    "monolithic": {
      "type": "boolean",
      "description": "Whether to generate a monolithic application"
    },
    "localazyReadKey": {
      "type": "string",
      "description": "Localazy read key"
    },
    "authentik": {
      "type": "boolean",
      "description": "Use authentik for authentication"
    },
    "oauth": {
      "type": "boolean",
      "description": "Use OAuth for authentication"
    },
    "skipProjects": {
      "type": "boolean",
      "description": "Whether to skip executing project specific initialization"
    },
    "skipFormat": {
      "type": "boolean"
    },
    "coerce": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {

          }
        }
      ]
    }
  },
  "required": []
}
