exports[`generateMonolithic() should generate a monolithic application configuration 3`] = `
"import { provideLayout, withNavigationConfig, withDefaultHeaderComponent, LayoutComponent } from '@rxap/layout';
import { provideUserTheme } from '@rxap/ngx-user';
import { APP_NAVIGATION } from './app.navigation';
import { Route } from '@angular/router';

export const ROUTES: Route[] = [
    {
      path: '',
      component: LayoutComponent,
      children: [
        {
          path: '**',
          redirectTo: ''
        }
      ],
      providers: [
        provideUserTheme(),
        provideLayout(
          withNavigationConfig(APP_NAVIGATION),
          withDefaultHeaderComponent(),
        )
      ]
    },
  {
    path: '**',
    redirectTo: ''
  }
  ];

export default ROUTES;
"
`;

