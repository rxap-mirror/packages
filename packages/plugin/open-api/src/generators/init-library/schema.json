{
  "$schema": "http://json-schema.org/schema",
  "$id": "InitLibrary",
  "title": "",
  "type": "object",
  "properties": {
    "project": {
      "type": "string"
    },
    "external": {
      "type": "boolean",
      "default": false,
      "x-prompt": "Is the open api specification source external?"
    },
    "skipFormat": {
      "type": "boolean",
      "default": false
    },
    "persistent": {
      "type": "boolean",
      "default": false
    }
  },
  "required": ["project"]
}
