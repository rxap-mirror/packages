{
  "name": "plugin-kraft",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/plugin/kraft/src",
  "projectType": "library",
  "release": {
    "version": {
      "generatorOptions": {
        "packageRoot": "dist/{projectRoot}",
        "currentVersionResolver": "git-tag"
      }
    }
  },
  "tags": ["plugin", "nx", "nx-plugin", "packages"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/plugin/kraft",
        "main": "packages/plugin/kraft/src/index.ts",
        "tsConfig": "packages/plugin/kraft/tsconfig.lib.json",
        "generateExportsField": true,
        "additionalEntryPoints": ["packages/plugin/kraft/src/plugin.ts"],
        "assets": [
          "packages/plugin/kraft/*.md",
          {
            "input": "./packages/plugin/kraft/src",
            "glob": "**/!(*.ts)",
            "output": "./src"
          },
          {
            "input": "./packages/plugin/kraft/src",
            "glob": "**/*.d.ts",
            "output": "./src"
          },
          {
            "input": "./packages/plugin/kraft",
            "glob": "generators.json",
            "output": "."
          },
          {
            "input": "./packages/plugin/kraft",
            "glob": "executors.json",
            "output": "."
          },
          {
            "input": "./packages/plugin/kraft/src/generators",
            "glob": "**/!(*.ts|*.js|*.json)",
            "output": "./src/generators"
          }
        ]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
