{
  "$schema": "https://json-schema.org/schema",
  "version": 2,
  "title": "kraft cloud tunnel",
  "type": "object",
  "$id": "CloudTunnel",
  "description": "Creates a secure tunnel to forward a local port to an unexposed instance.",
  "properties": {
    "localPort": {
      "type": "string",
      "description": "The local port"
    },
    "destPort": {
      "type": "string",
      "description": "The dest port"
    },
    "urlPath": {
      "type": "string",
      "description": "The url path added to the link preview"
    },
    "tunnel-control-port": { "type": "integer", "description": "Command-and-control port used by the tunneling service." },
    "tunnel-image": { "type": "string", "description": "Tunnel service image" },
    "tunnel-proxy-port": { "type": "array", "items": { "type": "string" }, "description": "Remote port exposed by the tunnelling service." },
    "buildkit-host": { "type": "string", "description": "Path to the buildkit host" },
    "config-dir": { "type": "string", "description": "Path to KraftKit config directory" },
    "containerd-addr": { "type": "string", "description": "Address of containerd daemon socket" },
    "editor": { "type": "string", "description": "Set the text editor for editing files" },
    "events-pid-file": { "type": "string", "description": "Events process ID for running multiple unikernels" },
    "git-protocol": { "type": "string", "description": "Preferred Git protocol to use" },
    "http-unix-sock": { "type": "string", "description": "Shared socket for HTTP(S) connections" },
    "log-level": { "type": "string", "description": "Log level verbosity" },
    "log-timestamps": { "type": "boolean", "description": "Enable log timestamps" },
    "log-type": { "type": "string", "description": "Log type format" },
    "manifests-dir": { "type": "string", "description": "Path to Unikraft manifest cache" },
    "metro": { "type": "string", "description": "Unikraft Cloud metro location" },
    "no-check-updates": { "type": "boolean", "description": "Disable update checks" },
    "no-color": { "type": "boolean", "description": "Disable color output" },
    "no-emojis": { "type": "boolean", "description": "Disable emojis in console output" },
    "no-parallel": { "type": "boolean", "description": "Disable parallel task execution" },
    "no-prompt": { "type": "boolean", "description": "Disable user interaction prompts" },
    "no-warn-sudo": { "type": "boolean", "description": "Suppress sudo warnings" },
    "pager": { "type": "string", "description": "System pager to use for output" },
    "plugins-dir": { "type": "string", "description": "Path to KraftKit plugin directory" },
    "qemu": { "type": "string", "description": "Path to QEMU executable" },
    "runtime-dir": { "type": "string", "description": "Directory for runtime files" },
    "sources-dir": { "type": "string", "description": "Path to Unikraft component cache" },
    "token": { "type": "string", "description": "Unikraft Cloud access token" },
    "with-manifest": { "type": "array", "items": { "type": "string" }, "description": "Paths to package or component manifests" },
    "with-mirror": { "type": "array", "items": { "type": "string" }, "description": "Paths to mirrors of Unikraft component artifacts" }
  },
  "required": ["destPort"]
}
