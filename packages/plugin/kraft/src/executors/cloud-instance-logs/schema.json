{
  "$schema": "https://json-schema.org/schema",
  "version": 2,
  "title": "kraft cloud instance logs",
  "type": "object",
  "$id": "CloudInstanceLogs",
  "description": "Get console output of an instance using 'kraft cloud instance logs'.",
  "properties": {
    "follow": {
      "type": "boolean",
      "description": "Follow the logs of the instance every half second."
    },
    "no-prefix": {
      "type": "boolean",
      "description": "Do not prefix each log line with the name when logging multiple machines."
    },
    "prefix": {
      "type": "string",
      "description": "Prefix the logs with a given string."
    },
    "tail": {
      "type": "integer",
      "description": "Show the last given lines from the logs (default -1)."
    },
    "buildkit-host": {
      "type": "string",
      "description": "Path to the buildkit host."
    },
    "config-dir": {
      "type": "string",
      "description": "Path to KraftKit config directory."
    },
    "containerd-addr": {
      "type": "string",
      "description": "Address of containerd daemon socket."
    },
    "editor": {
      "type": "string",
      "description": "Text editor to open when prompted to edit a file."
    },
    "events-pid-file": {
      "type": "string",
      "description": "Events process ID used when running multiple unikernels."
    },
    "git-protocol": {
      "type": "string",
      "description": "Preferred Git protocol to use (default 'https')."
    },
    "http-unix-sock": {
      "type": "string",
      "description": "Shared socket for HTTP(S) connections."
    },
    "log-level": {
      "type": "string",
      "enum": ["panic", "fatal", "error", "warn", "info", "debug", "trace"],
      "description": "Log level verbosity (default 'info')."
    },
    "log-timestamps": {
      "type": "boolean",
      "description": "Enable log timestamps."
    },
    "log-type": {
      "type": "string",
      "enum": ["fancy", "basic", "json"],
      "description": "Log type (default 'fancy')."
    },
    "manifests-dir": {
      "type": "string",
      "description": "Path to Unikraft manifest cache."
    },
    "metro": {
      "type": "string",
      "description": "Unikraft Cloud metro location."
    },
    "no-check-updates": {
      "type": "boolean",
      "description": "Do not check for updates."
    },
    "no-color": {
      "type": "boolean",
      "description": "Disable color output."
    },
    "no-emojis": {
      "type": "boolean",
      "description": "Do not use emojis in console output."
    },
    "no-parallel": {
      "type": "boolean",
      "description": "Do not run internal tasks in parallel."
    },
    "no-prompt": {
      "type": "boolean",
      "description": "Do not prompt for user interaction."
    },
    "no-warn-sudo": {
      "type": "boolean",
      "description": "Do not warn when running via sudo."
    },
    "pager": {
      "type": "string",
      "description": "System pager to pipe output to (default 'cat')."
    },
    "plugins-dir": {
      "type": "string",
      "description": "Path to KraftKit plugin directory."
    },
    "qemu": {
      "type": "string",
      "description": "Path to QEMU executable."
    },
    "runtime-dir": {
      "type": "string",
      "description": "Directory for placing runtime files (e.g., pidfiles)."
    },
    "sources-dir": {
      "type": "string",
      "description": "Path to Unikraft component cache."
    },
    "token": {
      "type": "string",
      "description": "Unikraft Cloud access token."
    },
    "with-manifest": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths to package or component manifests (default '[https://manifests.kraftkit.sh/index.yaml]')."
    },
    "with-mirror": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths to mirrors of Unikraft component artifacts."
    }
  },
  "required": []
}
