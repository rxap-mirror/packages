{
  "$schema": "https://json-schema.org/schema",
  "version": 2,
  "title": "kraft cloud instance stop",
  "type": "object",
  "$id": "CloudInstanceStop",
  "description": "Command to stop instances in Unikraft Cloud by UUID or NAME with various options.",
  "properties": {
    "all": { "type": "boolean", "description": "Stop all instances" },
    "drain-timeout": { "type": "string", "description": "Timeout for the instance to stop (ms/s/m/h)" },
    "force": { "type": "boolean", "description": "Force stop the instance(s)" },
    "wait": { "type": "string", "description": "Time to wait for the instance to drain all connections before stopping (ms/s/m/h)" },
    "buildkit-host": { "type": "string", "description": "Path to the buildkit host" },
    "config-dir": { "type": "string", "description": "Path to KraftKit configuration directory" },
    "containerd-addr": { "type": "string", "description": "Address of containerd daemon socket" },
    "editor": { "type": "string", "description": "Text editor for editing files" },
    "events-pid-file": { "type": "string", "description": "File storing events process ID for multiple unikernels" },
    "git-protocol": { "type": "string", "description": "Preferred Git protocol (default 'https')" },
    "http-unix-sock": { "type": "string", "description": "Shared socket for HTTP(S) connections" },
    "log-level": { "type": "string", "description": "Log level verbosity (default 'info')" },
    "log-timestamps": { "type": "boolean", "description": "Enable log timestamps" },
    "log-type": { "type": "string", "description": "Log type (default 'fancy')" },
    "manifests-dir": { "type": "string", "description": "Path to Unikraft manifest cache" },
    "metro": { "type": "string", "description": "Unikraft Cloud metro location" },
    "no-check-updates": { "type": "boolean", "description": "Disable update checks" },
    "no-color": { "type": "boolean", "description": "Disable color output" },
    "no-emojis": { "type": "boolean", "description": "Disable emojis in output" },
    "no-parallel": { "type": "boolean", "description": "Disable parallel internal tasks" },
    "no-prompt": { "type": "boolean", "description": "Disable user prompts" },
    "no-warn-sudo": { "type": "boolean", "description": "Disable warnings when running as sudo" },
    "pager": { "type": "string", "description": "System pager for output (default 'cat')" },
    "plugins-dir": { "type": "string", "description": "Path to KraftKit plugin directory" },
    "qemu": { "type": "string", "description": "Path to QEMU executable" },
    "runtime-dir": { "type": "string", "description": "Directory for runtime files" },
    "sources-dir": { "type": "string", "description": "Path to Unikraft component cache" },
    "token": { "type": "string", "description": "Unikraft Cloud access token" },
    "with-manifest": { "type": "array", "items": { "type": "string" }, "description": "Paths to package or component manifests" },
    "with-mirror": { "type": "array", "items": { "type": "string" }, "description": "Mirrors of Unikraft component artifacts" }
  },
  "required": []
}
