{
  "$schema": "https://json-schema.org/schema",
  "version": 2,
  "title": "kraft cloud instance get",
  "type": "object",
  "$id": "CloudInstanceGet",
  "description": "Retrieve the state of a cloud instance by UUID or NAME.",
  "properties": {
    "output": { "type": "string", "enum": ["table", "yaml", "json", "list"], "description": "Set output format (options: table, yaml, json, list)" },
    "buildkit-host": { "type": "string", "description": "Path to the BuildKit host" },
    "config-dir": { "type": "string", "description": "Path to KraftKit config directory" },
    "containerd-addr": { "type": "string", "description": "Address of containerd daemon socket" },
    "editor": { "type": "string", "description": "Text editor to open when prompted to edit a file" },
    "events-pid-file": { "type": "string", "description": "Events process ID for multiple unikernels" },
    "git-protocol": { "type": "string", "description": "Preferred Git protocol" },
    "http-unix-sock": { "type": "string", "description": "Shared socket for HTTP(S) requests" },
    "log-level": { "type": "string", "enum": ["panic", "fatal", "error", "warn", "info", "debug", "trace"], "description": "Log level verbosity" },
    "log-timestamps": { "type": "boolean", "description": "Enable log timestamps" },
    "log-type": { "type": "string", "enum": ["fancy", "basic", "json"], "description": "Log type" },
    "metro": { "type": "string", "description": "Unikraft Cloud metro location" },
    "no-check-updates": { "type": "boolean", "description": "Do not check for updates" },
    "no-color": { "type": "boolean", "description": "Disable color output" },
    "no-emojis": { "type": "boolean", "description": "Do not use emojis in console output" },
    "no-parallel": { "type": "boolean", "description": "Do not run internal tasks in parallel" },
    "no-prompt": { "type": "boolean", "description": "Do not prompt for user interaction" },
    "no-warn-sudo": { "type": "boolean", "description": "Do not warn when running via sudo" },
    "pager": { "type": "string", "description": "System pager to pipe output to" },
    "plugins-dir": { "type": "string", "description": "Path to KraftKit plugin directory" },
    "qemu": { "type": "string", "description": "Path to QEMU executable" },
    "runtime-dir": { "type": "string", "description": "Directory for runtime files placement" },
    "sources-dir": { "type": "string", "description": "Path to Unikraft component cache" },
    "token": { "type": "string", "description": "Unikraft Cloud access token" },
    "with-manifest": { "type": "array", "items": { "type": "string" }, "description": "Paths to package or component manifests" },
    "with-mirror": { "type": "array", "items": { "type": "string" }, "description": "Paths to mirrors of Unikraft component artifacts" }
  },
  "required": []
}
