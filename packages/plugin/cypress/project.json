{
  "name": "plugin-cypress",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/plugin/cypress/src",
  "projectType": "library",
  "tags": ["plugin", "nx", "nx-plugin", "packages"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/plugin/cypress",
        "main": "packages/plugin/cypress/src/index.ts",
        "tsConfig": "packages/plugin/cypress/tsconfig.lib.json",
        "assets": [
          "packages/plugin/cypress/*.md",
          {
            "input": "./packages/plugin/cypress/src",
            "glob": "**/!(*.ts)",
            "output": "./src"
          },
          {
            "input": "./packages/plugin/cypress/src",
            "glob": "**/*.d.ts",
            "output": "./src"
          },
          {
            "input": "./packages/plugin/cypress",
            "glob": "generators.json",
            "output": "."
          },
          {
            "input": "./packages/plugin/cypress",
            "glob": "executors.json",
            "output": "."
          },
          "packages/plugin/cypress/docs"
        ]
      }
    },


    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/plugin/cypress/jest.config.ts"
      }
    },






    "expose-as-schematic": {
      "executor": "@rxap/plugin-library:run-generator",
      "options": {
        "generator": "@rxap/plugin-library:expose-as-schematic"
      }
    }
  }
}
