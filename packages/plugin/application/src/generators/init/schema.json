{
  "$schema": "http://json-schema.org/schema",
  "$id": "Init",
  "title": "",
  "type": "object",
  "properties": {
    "project": {
      "type": "string"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dockerImageName": {
      "type": "string"
    },
    "dockerImageSuffix": {
      "type": "string"
    },
    "dockerImageRegistry": {
      "type": "string"
    },
    "overwrite": {
      "type": "boolean",
      "default": false,
      "description": "Whether to overwrite existing files"
    },
    "skipDocker": {
      "type": "boolean",
      "description": "Whether to skip the docker configuration"
    },
    "skipFormat": {
      "type": "boolean",
      "default": false
    },
    "skipProjects": {
      "type": "boolean",
      "default": false,
      "description": "Whether to skip executing project specific initialization"
    },
    "authentik": {
      "type": "boolean",
      "default": false,
      "description": "Whether to initialize authentik docker compose setup"
    },
    "standalone": {
      "type": "boolean",
      "description": "If true, the workspace will be initialized for standalone development",
      "default": false
    },
    "minio": {
      "type": "boolean",
      "default": false,
      "description": "Whether to initialize minio docker compose setup"
    },
    "authentication": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["oauth2-proxy"]
        },
        {
          "type": "boolean",
          "default": false
        }
      ]
    }
  },
  "required": []
}
