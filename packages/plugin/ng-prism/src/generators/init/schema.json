{
  "$schema": "http://json-schema.org/schema",
  "$id": "Init",
  "title": "",
  "type": "object",
  "properties": {
    "prismProject": {
      "type": "string",
      "default": "prism-host",
      "description": "The name of the shared styleguide host application project.",
      "examples": [
        "prism-host"
      ]
    },
    "skipFormat": {
      "type": "boolean",
      "default": false,
      "description": "Whether to skip formatting generated files.",
      "examples": [
        true,
        false
      ]
    },
    "overwrite": {
      "type": "boolean",
      "default": false,
      "description": "Whether to overwrite existing files.",
      "examples": [
        true,
        false
      ]
    }
  },
  "required": []
}
