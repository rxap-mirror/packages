{
  "version": "24.0.0-dev.1",
  "name": "@rxap/plugin-ng-prism",
  "description": "This plugin provides generators to set up ng-prism styleguides for Angular libraries within an Nx workspace. It creates a shared styleguide host application, adds the prism, prism-build and prism-strip targets to libraries and removes the @Showcase decorators from the built packages before publishing.\n",
