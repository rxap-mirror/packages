  "dependencies": {
    "@nx/devkit": "24.0.6",
    "@rxap/utilities": "^16.5.3-dev.0",
    "@rxap/workspace-utilities": "^24.0.0-dev.1",
    "tslib": "2.9.1"
  },
  "author": {
    "name": "Merzough Münker",
    "email": "mmuenker@digitaix.com"
  },
  "bugs": {
    "url": "https://gitlab.com/rxap/packages/-/issues",
    "email": "incoming+rxap-packages-14898188-issue-@incoming.gitlab.com"
  },
  "generators": "./generators.json",
  "homepage": "https:/gitlab.com/rxap/packages/packages/plugin/ng-prism",
  "keywords": [
    "ng-prism",
    "nx",
    "nx-plugin",
    "packages",
