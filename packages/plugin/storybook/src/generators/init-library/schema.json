{
  "$schema": "http://json-schema.org/schema",
  "$id": "InitLibrary",
  "title": "",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "description": "The name of the project.",
      "examples": [
        "my-lib"
      ]
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "A list of projects to initialize Storybook for.",
      "examples": [
        [
          "lib1",
          "lib2"
        ]
      ]
    },
    "overwrite": {
      "type": "boolean",
      "default": false,
      "description": "Whether to overwrite existing files.",
      "examples": [
        true,
        false
      ]
    },
    "skipProjects": {
      "type": "boolean",
      "default": false,
      "description": "Whether to skip executing project specific initialization",
      "examples": [
        true,
        false
      ]
    },
    "interactionTests": {
      "type": "boolean",
      "description": "Set up Storybook interaction tests.",
      "alias": ["configureTestRunner"],
      "x-priority": "important",
      "default": true,
      "examples": [
        true,
        false
      ]
    },
    "configureCypress": {
      "type": "boolean",
      "description": "Specifies whether to configure Cypress or not.",
      "examples": [
        true,
        false
      ]
    },
    "generateStories": {
      "type": "boolean",
      "description": "Specifies whether to automatically generate `*.stories.ts` files for components declared in this project or not.",
      "default": true,
      "x-priority": "important",
      "examples": [
        true,
        false
      ]
    },
    "generateCypressSpecs": {
      "type": "boolean",
      "description": "Specifies whether to automatically generate test files in the generated Cypress e2e app.",
      "examples": [
        true,
        false
      ]
    },
    "configureStaticServe": {
      "type": "boolean",
      "description": "Specifies whether to configure a static file server target for serving storybook. Helpful for speeding up CI build/test times.",
      "default": true,
      "x-priority": "important",
      "examples": [
        true,
        false
      ]
    },
    "cypressDirectory": {
      "type": "string",
      "description": "A directory where the Cypress project will be placed. Placed at the root by default.",
      "examples": [
        "libs/my-lib-e2e"
      ]
    },
    "linter": {
      "description": "The tool to use for running lint checks.",
      "type": "string",
      "enum": ["eslint", "none"],
      "default": "eslint",
      "examples": [
        "eslint",
        "none"
      ]
    },
    "tsConfiguration": {
      "type": "boolean",
      "description": "Configure your project with TypeScript. Generate main.ts and preview.ts files, instead of main.js and preview.js.",
      "default": true,
      "x-priority": "important",
      "examples": [
        true,
        false
      ]
    },
    "skipFormat": {
      "description": "Skip formatting files.",
      "type": "boolean",
      "default": false,
      "x-priority": "internal",
      "examples": [
        true,
        false
      ]
    },
    "ignorePaths": {
      "type": "array",
      "description": "Paths to ignore when looking for components.",
      "items": {
        "type": "string",
        "description": "Path to ignore."
      },
      "examples": [
        "apps/my-app/src/not-stories/**",
        "**/**/src/**/not-stories/**",
        "libs/my-lib/**/*.something.ts",
        "**/**/src/**/*.other.*",
        "libs/my-lib/src/not-stories/**,**/**/src/**/*.other.*,apps/my-app/**/*.something.ts"
      ]
    },
    "compodoc": {
      "type": "boolean",
      "description": "Generate documentation using Compodoc.",
      "default": true,
      "examples": [
        true,
        false
      ]
    }
  },
  "required": []
}
