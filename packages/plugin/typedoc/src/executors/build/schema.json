{
  "$schema": "http://json-schema.org/schema",
  "version": 2,
  "$id": "Build",
  "title": "Build executor",
  "description": "",
  "type": "object",
  "properties": {
    "entryPoints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tsconfig": {
      "type": "string"
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "json": {
      "type": "boolean"
    },
    "html": {
      "type": "boolean"
    },
    "skipErrorChecking": {
      "type": "boolean"
    },
    "markdown": {
      "type": "boolean"
    },
    "wiki": {
      "type": "boolean"
    },
    "includeVersion": {
      "type": "boolean"
    },
    "entryPointStrategy": {
      "type": "string",
      "enum": ["expand", "merge", "packages", "resolve"]
    }
  },
  "required": ["tsconfig"]
}
