{
  "name": "generator-utilities",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/generator/utilities/src",
  "projectType": "library",
  "tags": ["packages", "generator", "scope:utilities"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/generator/utilities",
        "main": "packages/generator/utilities/src/index.ts",
        "tsConfig": "packages/generator/utilities/tsconfig.lib.json",
        "assets": [
          "packages/generator/utilities/*.md",
          "packages/generator/utilities/docs"
        ]
      }
    },
    "fix-dependencies": {
      "options": {
        "options": {
          "strict": true,
          "onlyDependencies": true
        },
        "generator": "@rxap/plugin-library:fix-dependencies"
      },
      "executor": "@rxap/plugin-library:run-generator",
      "outputs": ["{projectRoot}/package.json"]
    },
    "lint": {
      "options": {
        "lintFilePatterns": ["packages/generator/utilities/**/*.ts"]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs generator-utilities {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },
    "readme": {},
    "test": {
      "options": {
        "jestConfig": "packages/generator/utilities/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "typedoc": {
      "executor": "@enio.ai/typedoc:typedoc",
      "outputs": ["{workspaceRoot}/docs/packages/generator/utilities"],
      "options": {
        "options": "typedoc.json",
        "outputPath": [
          "dist/docs/packages/generator/utilities",
          "packages/generator/utilities/docs"
        ]
      }
    },
    "update-dependencies": {},
    "update-package-group": {},
    "linking": {}
  }
}
