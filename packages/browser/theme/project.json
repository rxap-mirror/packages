{
  "name": "browser-theme",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/browser/theme/src",
  "projectType": "library",
  "tags": ["packages", "browser"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/browser/theme",
        "main": "packages/browser/theme/src/index.ts",
        "tsConfig": "packages/browser/theme/tsconfig.lib.json",
        "assets": ["packages/browser/theme/*.md"]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
