{
  "name": "browser-tailwind",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/browser/tailwind/src",
  "projectType": "library",
  "tags": ["packages", "browser", "scope:utilities"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/browser/tailwind",
        "main": "packages/browser/tailwind/src/index.ts",
        "tsConfig": "packages/browser/tailwind/tsconfig.lib.json",
        "assets": [
          "packages/browser/tailwind/*.md",
          "packages/browser/tailwind/docs"
        ]
      }
    },
    "fix-dependencies": {
      "options": {
        "options": {
          "strict": true,
          "onlyDependencies": true
        },
        "generator": "@rxap/plugin-library:fix-dependencies"
      },
      "executor": "@rxap/plugin-library:run-generator",
      "outputs": ["{projectRoot}/package.json"]
    },
    "lint": {
      "options": {
        "lintFilePatterns": ["packages/browser/tailwind/**/*.ts"]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs browser-tailwind {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },
    "readme": {},
    "test": {
      "options": {
        "jestConfig": "packages/browser/tailwind/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "update-dependencies": {},
    "update-package-group": {},
    "linking": {},
    "index-export": {},
    "typedoc": {
      "options": {
        "outputPath": [
          "dist/docs/packages/browser/tailwind",
          "packages/browser/tailwind/docs"
        ]
      }
    }
  }
}
