{
  "name": "xml-parser",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/xml-parser/src",
  "projectType": "library",
  "tags": ["packages", "scope:utilities", "standalone"],
  "targets": {
    "index-export": {},
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/xml-parser",
        "main": "packages/xml-parser/src/index.ts",
        "tsConfig": "packages/xml-parser/tsconfig.lib.json",
        "assets": ["packages/xml-parser/*.md", "packages/xml-parser/docs"]
      }
    },
    "fix-dependencies": {
      "options": {
        "options": {
          "strict": true,
          "onlyDependencies": true
        },
        "generator": "@rxap/plugin-library:fix-dependencies"
      },
      "executor": "@rxap/plugin-library:run-generator",
      "outputs": ["{projectRoot}/package.json"]
    },
    "lint": {
      "options": {
        "lintFilePatterns": ["packages/xml-parser/**/*.ts"]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs xml-parser {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },
    "readme": {},
    "test": {
      "options": {
        "jestConfig": "packages/xml-parser/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "update-dependencies": {},
    "update-package-group": {},
    "linking": {},
    "typedoc": {
      "options": {
        "outputPath": [
          "dist/docs/packages/xml-parser",
          "packages/xml-parser/docs"
        ]
      }
    }
  }
}
