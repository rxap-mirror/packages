{
  "name": "preset-workspace",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/preset/workspace/src",
  "projectType": "library",
  "release": {
    "version": {
      "generatorOptions": {
        "packageRoot": "dist/{projectRoot}",
        "currentVersionResolver": "git-tag"
      }
    }
  },
  "tags": ["plugin", "nx", "nx-plugin", "packages", "preset"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/preset/workspace",
        "main": "packages/preset/workspace/src/index.ts",
        "tsConfig": "packages/preset/workspace/tsconfig.lib.json",
        "assets": [
          "packages/preset/workspace/*.md",
          {
            "input": "./packages/preset/workspace/src",
            "glob": "**/!(*.ts)",
            "output": "./src"
          },
          {
            "input": "./packages/preset/workspace/src",
            "glob": "**/*.d.ts",
            "output": "./src"
          },
          {
            "input": "./packages/preset/workspace",
            "glob": "generators.json",
            "output": "."
          },
          {
            "input": "./packages/preset/workspace",
            "glob": "executors.json",
            "output": "."
          },
          "packages/preset/workspace/docs"
        ]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/preset/workspace/jest.config.ts"
      }
    },





    "expose-as-schematic": {
      "executor": "@rxap/plugin-library:run-generator",
      "options": {
        "generator": "@rxap/plugin-library:expose-as-schematic"
      }
    }
  }
}
