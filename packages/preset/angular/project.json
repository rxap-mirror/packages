{
  "name": "preset-angular",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/preset/angular/src",
  "projectType": "library",
  "release": {
    "version": {
      "generatorOptions": {
        "packageRoot": "dist/{projectRoot}",
        "currentVersionResolver": "git-tag"
      }
    }
  },
  "tags": ["plugin", "nx", "nx-plugin", "packages", "preset"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/preset/angular",
        "main": "packages/preset/angular/src/index.ts",
        "tsConfig": "packages/preset/angular/tsconfig.lib.json",
        "assets": [
          "packages/preset/angular/*.md",
          {
            "input": "./packages/preset/angular/src",
            "glob": "**/!(*.ts)",
            "output": "./src"
          },
          {
            "input": "./packages/preset/angular/src",
            "glob": "**/*.d.ts",
            "output": "./src"
          },
          {
            "input": "./packages/preset/angular",
            "glob": "generators.json",
            "output": "."
          },
          {
            "input": "./packages/preset/angular",
            "glob": "executors.json",
            "output": "."
          }
        ]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/preset/angular/jest.config.ts"
      }
    },
    "update-dependencies": {
      "executor": "@rxap/plugin-library:update-dependencies"
    },
    "update-package-group": {
      "executor": "@rxap/plugin-library:update-package-group"
    },
    "readme": {
      "executor": "@rxap/plugin-library:readme"
    },
    "fix-dependencies": {
      "executor": "@rxap/plugin-library:run-generator",
      "outputs": ["{projectRoot}/package.json"],
      "options": {
        "generator": "@rxap/plugin-library:fix-dependencies",
        "options": {
          "strict": true,
          "onlyDependencies": true
        }
      }
    },
    "linking": {},
    "check-version": {
      "executor": "@rxap/plugin-library:check-version",
      "options": {
        "packageName": "nx"
      }
    },
    "expose-as-schematic": {
      "executor": "@rxap/plugin-library:run-generator",
      "options": {
        "generator": "@rxap/plugin-library:expose-as-schematic"
      }
    }
  }
}
