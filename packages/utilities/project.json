{
  "name": "utilities",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/utilities/src",
  "projectType": "library",
  "tags": ["packages", "standalone", "scope:utilities"],
  "targets": {
    "linking": {},
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/utilities",
        "main": "packages/utilities/src/index.ts",
        "tsConfig": "packages/utilities/tsconfig.lib.json",
        "assets": [
          "packages/utilities/*.md",
          "packages/utilities/docs",
          {
            "input": "./packages/utilities/src/generators",
            "glob": "**/!(*.ts|*.js|*.json)",
            "output": "./src/generators"
          },
          {
            "input": "./packages/utilities",
            "glob": "generators.json",
            "output": "."
          }
        ]
      }
    },
    "fix-dependencies": {
      "options": {
        "options": {
          "strict": true,
          "onlyDependencies": true
        },
        "generator": "@rxap/plugin-library:fix-dependencies"
      },
      "executor": "@rxap/plugin-library:run-generator",
      "outputs": ["{projectRoot}/package.json"]
    },
    "index-export": {},
    "lint": {
      "options": {
        "lintFilePatterns": ["packages/utilities/**/*.ts"]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs utilities {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },
    "readme": {},
    "test": {
      "options": {
        "jestConfig": "packages/utilities/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "update-dependencies": {},
    "update-package-group": {},
    "typedoc": {
      "options": {
        "outputPath": [
          "dist/docs/packages/utilities",
          "packages/utilities/docs"
        ]
      }
    }
  }
}
