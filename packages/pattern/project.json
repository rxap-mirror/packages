{
  "name": "pattern",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/pattern/src",
  "projectType": "library",
  "tags": ["packages", "standalone", "scope:utilities"],
  "targets": {

    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/pattern",
        "main": "packages/pattern/src/index.ts",
        "tsConfig": "packages/pattern/tsconfig.lib.json",
        "assets": ["packages/pattern/*.md", "packages/pattern/docs"]
      }
    },

    "lint": {
      "options": {
        "lintFilePatterns": ["packages/pattern/**/*.ts"]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs pattern {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },

    "test": {
      "options": {
        "jestConfig": "packages/pattern/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },



    "typedoc": {
      "options": {
        "outputPath": ["dist/docs/packages/pattern", "packages/pattern/docs"]
      }
    }
  }
}
