{
  "name": "node-utilities",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/node/utilities/src",
  "projectType": "library",
  "tags": ["node", "packages", "scope:utilities"],
  "implicitDependencies": ["!rxap"],
  "targets": {

    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/node/utilities",
        "main": "packages/node/utilities/src/index.ts",
        "tsConfig": "packages/node/utilities/tsconfig.lib.json",
        "assets": [
          "packages/node/utilities/*.md",
          "packages/node/utilities/docs"
        ]
      }
    },

    "lint": {
      "options": {
        "lintFilePatterns": ["packages/node/utilities/**/*.ts"]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs node-utilities {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },

    "test": {
      "options": {
        "jestConfig": "packages/node/utilities/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "typedoc": {
      "executor": "@enio.ai/typedoc:typedoc",
      "outputs": ["{workspaceRoot}/docs/packages/node/utilities"],
      "options": {
        "options": "typedoc.json",
        "outputPath": [
          "dist/docs/packages/node/utilities",
          "packages/node/utilities/docs"
        ]
      }
    },


    "linking": {}
  }
}
