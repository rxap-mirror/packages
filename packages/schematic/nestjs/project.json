{
  "name": "schematic-nestjs",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/schematic/nestjs/src",
  "projectType": "library",
  "tags": ["packages", "schematic"],
  "implicitDependencies": ["plugin-nestjs", "plugin-application"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/schematic/nestjs",
        "main": "packages/schematic/nestjs/src/index.ts",
        "tsConfig": "packages/schematic/nestjs/tsconfig.lib.json",
        "assets": [
          "packages/schematic/nestjs/*.md",
          {
            "input": "./packages/schematic/nestjs/src",
            "glob": "**/!(*.ts)",
            "output": "./src"
          },
          {
            "input": "./packages/schematic/nestjs/src",
            "glob": "**/*.d.ts",
            "output": "./src"
          },
          {
            "input": "./packages/schematic/nestjs",
            "glob": "collection.json",
            "output": "."
          },
          "packages/schematic/nestjs/docs",
          {
            "input": "./packages/schematic/nestjs/src/generators",
            "glob": "**/!(*.ts|*.js|*.json)",
            "output": "./src/generators"
          },
          {
            "input": "./packages/schematic/nestjs",
            "glob": "generators.json",
            "output": "."
          }
        ]
      }
    },
    "lint": {
      "options": {
        "lintFilePatterns": ["packages/schematic/nestjs/**/*.ts"]
      }
    }
  }
}
