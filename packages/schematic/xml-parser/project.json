{
  "name": "schematic-xml-parser",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/schematic/xml-parser/src",
  "projectType": "library",
  "tags": ["packages", "schematic", "scope:utilities"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/schematic/xml-parser",
        "main": "packages/schematic/xml-parser/src/index.ts",
        "tsConfig": "packages/schematic/xml-parser/tsconfig.lib.json",
        "assets": ["packages/schematic/xml-parser/*.md"]
      }
    },
    "fix-dependencies": {
      "options": {
        "options": {
          "strict": true,
          "onlyDependencies": true
        },
        "generator": "@rxap/plugin-library:fix-dependencies"
      },
      "executor": "@rxap/plugin-library:run-generator",
      "outputs": ["{projectRoot}/package.json"]
    },
    "lint": {
      "options": {
        "lintFilePatterns": ["packages/schematic/xml-parser/**/*.ts"]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs schematic-xml-parser {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },
    "readme": {},
    "test": {
      "options": {
        "jestConfig": "packages/schematic/xml-parser/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "update-dependencies": {},
    "update-package-group": {},
    "linking": {},
    "check-version": {
      "executor": "@rxap/plugin-library:check-version",
      "options": {
        "packageName": "@angular-devkit/schematics"
      }
    }
  }
}
