
@switch (data.{{item.switch.property.name}}) {
  {{#each item.switch.case}}
  @case ({{propertyValue this.test}}) {
  {{#each this.itemList}}
  {{#if this.ifTruthy}}
  @if (data.{{this.ifTruthy.property.name}}) {
  {{/if}}
  {{#if this.permission}}
  <ng-template rxapIfHasPermission="{{item.permission}}">
  {{/if}}
  {{ indent (compile this.handlebars item=this prefix=../../prefix) 2 }}
  {{#if this.permission}}
  </ng-template>
  {{/if}}
  {{#if this.ifTruthy}}
  }
  {{/if}}
  {{/each}}
  }
  {{/each}}
  {{#if item.switch.defaultCase}}
  @default {
  {{#each item.switch.defaultCase.itemList}}
  {{#if this.ifTruthy}}
  @if (data.{{this.ifTruthy.property.name}}) {
  {{/if}}
  {{#if this.permission}}
  <ng-template rxapIfHasPermission="{{item.permission}}">
  {{/if}}
  {{ indent (compile this.handlebars item=this prefix=../prefix) 2 }}
  {{#if this.permission}}
  </ng-template>
  {{/if}}
  {{#if this.ifTruthy}}
  }
  {{/if}}
  {{/each}}
  }
  {{/if}}
}
