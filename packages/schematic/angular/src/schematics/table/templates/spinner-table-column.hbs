{{#> matColumnDef column=column}}
  {{#if table.withHeader}}
  <th mat-header-cell
    *matHeaderCellDef
    {{#if column.sortable}}
    mat-sort-header
    {{/if}}
    {{#if column.headerCssClass}}
    {{> cssClass cssClass=column.headerCssClass}}
    {{/if}}
  ></th>
  {{/if}}
  <td *matCellDef="let element"
    mat-cell
    {{#if column.cssClass}}
    {{> cssClass cssClass=column.cssClass}}
    {{/if}}
  >
    @if (element.__metadata__?.loading$ | async) {
    <mat-spinner diameter="15"></mat-spinner>
    } @else {
    <div class="w-[15px] h-[15px]"></div>
    }
  </td>
{{/matColumnDef}}
