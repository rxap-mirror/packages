{
  "$schema": "http://json-schema.org/schema",
  "$id": "backend",
  "oneOf": [
    {
      "type": "string",
      "enum": [
        "none",
        "nestjs",
        "open-api",
        "local",
        "data-source"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "none",
            "nestjs",
            "open-api",
            "local",
            "data-source"
          ]
        },
        "project": {
          "type": "string"
        },
        "serverId": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    }
  ],
  "description": "The backend that should be used to handel data",
  "default": "none"
}
