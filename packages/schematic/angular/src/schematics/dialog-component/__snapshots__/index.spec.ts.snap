  "/ui/lib/src/lib/test-dialog/test-dialog.component.ts": "import { Component, ChangeDetectionStrategy, inject } from '@angular/core';
import { MatDialogModule, MatDialogRef, MAT_DIALOG_DATA } from '@angular/material/dialog';
import { MatButtonModule } from '@angular/material/button';
import { MatProgressBarModule } from '@angular/material/progress-bar';
import { AsyncPipe } from '@angular/common';
import { ToggleSubject } from '@rxap/rxjs';

@Component({
    standalone: true,
    selector: 'jest-test-dialog',
    changeDetection: ChangeDetectionStrategy.OnPush,
    templateUrl: './test-dialog.component.html',
    styleUrls: ['./test-dialog.component.scss'],
  imports: [MatDialogModule, MatButtonModule, MatProgressBarModule, AsyncPipe],
})
export class TestDialogComponent {
  readonly data: any = inject(MAT_DIALOG_DATA);
  readonly matDialogRef: MatDialogRef<any> = inject(MatDialogRef);
  readonly invalid$ = new ToggleSubject(true);
  readonly loading$ = new ToggleSubject(true);

  async submit() {
    this.matDialogRef.close(true);
  }
}
",
}
`;

