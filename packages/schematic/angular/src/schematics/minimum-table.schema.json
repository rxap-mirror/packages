{
  "$schema": "http://json-schema.org/schema",
  "$id": "minimum-table",
  "type": "object",
  "properties": {
    "propertyList": {
      "alias": "property",
      "type": "array",
      "items": {
        "$ref": "#/definitions/property"
      }
    },
    "upstream": {
      "$ref": "#/definitions/upstream"
    },
    "rowId": {
      "$ref": "#/definitions/property"
    },
    "columnList": {
      "alias": "column",
      "type": "array",
      "items": {
        "$ref": "#/definitions/tableColumn"
      },
      "description": "List of table column names"
    },
    "actionList": {
      "alias": "action",
      "type": "array",
      "items": {
        "$ref": "#/definitions/tableAction"
      }
    },
    "headerButton": {
      "$ref": "#/definitions/headerButton"
    },
    "modifiers": {
      "alias": "modifier",
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The table modifiers"
    },
    "cssClass": {
      "$ref": "#/definitions/cssClass"
    },
    "identifier": {
      "$ref": "#/definitions/accordionIdentifier"
    },
    "sortable": {
      "description": "Whether the table is sortable",
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether the table is sortable",
              "default": true
            },
            "default": {
              "type": "object",
              "properties": {
                "active": {
                  "type": "string",
                  "description": "The default active column"
                },
                "direction": {
                  "type": "string",
                  "description": "The default sort direction",
                  "enum": ["asc", "desc"]
                }
              }
            }
          },
          "required": ["enabled"]
        }
      ]
    }
  },
  "definitions": {
    "headerButton": {
      "$ref": "./header-button.schema.json"
    },
    "tableAction": {
      "$ref": "./table-action.schema.json"
    },
    "tableColumn": {
      "$ref": "./table-column.schema.json"
    },
    "property": {
      "$ref": "./property.schema.json"
    },
    "upstream": {
      "$ref": "./upstream.schema.json"
    },
    "cssClass": {
      "$ref": "./css-class.schema.json"
    },
    "accordionIdentifier": {
      "$ref": "./accordion-identifier.schema.json"
    }
  }
}
