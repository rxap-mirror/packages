{
  "$schema": "http://json-schema.org/schema",
  "$id": "dialog-table-action",
  "allOf": [
    {
      "$ref": "#/definitions/baseTableAction"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "dialog",
          "default": "dialog"
        },
        "withoutBody": {
          "type": "boolean",
          "description": "Whether the table action operation should be without body",
          "default": false
        },
        "actionList": {
          "alias": "action",
          "type": "array",
          "description": "The list of actions to be added to the dialog",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "color": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "submit",
                      "close"
                    ]
                  }
                }
              }
            ]
          }
        },
        "title": {
          "type": "string",
          "description": "The title for the dialog"
        }
      },
      "required": ["kind", "title"]
    }
  ],
  "definitions": {
    "baseTableAction": {
      "$ref": "./base-table-action.schema.json"
    }
  }

}
