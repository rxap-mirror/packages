{
  "name": "schematic-composer",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/schematic/composer/src",
  "projectType": "library",
  "tags": ["packages", "schematic"],
  "implicitDependencies": [
    "schematic-angular",
    "schematic-nestjs",
    "schematic-open-api",
    "schematic-ts-morph",
    "schematic-utilities",
    "schematic-xml-parser",
    "plugin-angular",
    "plugin-application",
    "plugin-docker",
    "plugin-gitlab-ci",
    "plugin-gpt",
    "plugin-library",
    "plugin-localazy",
    "plugin-nestjs",
    "plugin-cypress",
    "plugin-open-api",
    "plugin-utilities",
    "plugin-web3-storage",
    "plugin-workspace",
    "plugin-storybook",
    "plugin-compodoc",
    "plugin-typedoc"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/schematic/composer",
        "main": "packages/schematic/composer/src/index.ts",
        "tsConfig": "packages/schematic/composer/tsconfig.lib.json",
        "assets": [
          "packages/schematic/composer/*.md",
          {
            "input": "./packages/schematic/composer/src",
            "glob": "**/!(*.ts)",
            "output": "./src"
          },
          {
            "input": "./packages/schematic/composer/src",
            "glob": "**/*.d.ts",
            "output": "./src"
          },
          {
            "input": "./packages/schematic/composer",
            "glob": "collection.json",
            "output": "."
          },
          "packages/schematic/composer/docs"
        ]
      }
    },

    "lint": {
      "options": {
        "lintFilePatterns": ["packages/schematic/composer/**/*.ts"]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs schematic-composer {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },

    "test": {
      "options": {
        "jestConfig": "packages/schematic/composer/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    }
  }
}
