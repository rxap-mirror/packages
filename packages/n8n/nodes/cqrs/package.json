{
  "version": "0.0.7-dev.0",
  "name": "@rxap/n8n-nodes-cqrs",
  "description": "This package provides base classes for creating n8n nodes that interact with RabbitMQ using the CQRS pattern. It includes nodes for sending commands, queries, and events, as well as trigger nodes for listening to specific patterns. The nodes are configured using JSON schemas to define the available operations and payload structures.\n",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@nx/devkit": "20.5.0",
    "@rxap/n8n-utilities": "^1.2.3-dev.0",
    "@rxap/utilities": "^16.5.1-dev.0",
    "amqplib": "^0.10.4",
    "openapi-types": "10.0.0",
    "rxjs": "7.8.1",
    "tslib": "^2.3.0",
    "uuid": "8.3.2"
  },
  "peerDependencies": {
    "n8n-workflow": "^1.82.0"
  },
  "author": {
    "name": "Merzough Münker",
    "email": "mmuenker@digitaix.com"
  },
  "bugs": {
    "url": "https://gitlab.com/rxap/packages/-/issues",
    "email": "incoming+rxap-packages-14898188-issue-@incoming.gitlab.com"
  },
  "generators": "./generators.json",
  "homepage": "https:/gitlab.com/rxap/packages/packages/n8n/nodes/cqrs",
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "n8n-nodes-cqrs",
    "nodes",
    "packages",
    "rxap"
  ],
  "main": "./src/index.js",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "src/lib/Query/Query.node.js",
      "src/lib/Command/Command.node.js",
      "src/lib/Event/Event.node.js",
      "src/lib/Query/QueryTrigger.node.js",
      "src/lib/Command/CommandTrigger.node.js",
      "src/lib/Event/EventTrigger.node.js"
    ],
    "credentials": []
  },
  "publishConfig": {
    "access": "public",
    "directory": "../../../../dist/packages/n8n/nodes/cqrs"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/rxap/packages.git",
    "directory": "packages/n8n/nodes/cqrs"
  },
  "type": "commonjs",
  "types": "./src/index.d.ts"
}
