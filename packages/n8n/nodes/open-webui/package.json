{
  "version": "0.0.3-dev.0",
  "name": "@rxap/n8n-nodes-open-webui",
  "description": "This package provides an n8n node for interacting with the Open Web UI. It leverages the `@rxap/n8n-utilities` package and an OpenAPI definition to simplify the integration. The node allows users to connect and utilize the functionalities exposed by the Open Web UI.\n",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@nx/devkit": "20.4.6",
    "@rxap/n8n-utilities": "^1.1.1-dev.0",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": "^1.48.0"
  },
  "author": {
    "name": "Merzough Münker",
    "email": "mmuenker@digitaix.com"
  },
  "bugs": {
    "url": "https://gitlab.com/rxap/packages/-/issues",
    "email": "incoming+rxap-packages-14898188-issue-@incoming.gitlab.com"
  },
  "generators": "./generators.json",
  "homepage": "https:/gitlab.com/rxap/packages/packages/n8n/nodes/open-webui",
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "n8n-nodes-open-webui",
    "nodes",
    "packages",
    "rxap"
  ],
  "main": "./src/index.js",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "src/lib/OpenWebUI/OpenWebUI.node.js"
    ],
    "credentials": [
      "src/lib/HttpBearerAuth.credentials.js",
      "src/lib/Oauth2ProxyAuth.credentials.js"
    ]
  },
  "publishConfig": {
    "access": "public",
    "directory": "../../../../dist/packages/n8n/nodes/open-webui"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/rxap/packages.git",
    "directory": "packages/n8n/nodes/open-webui"
  },
  "type": "commonjs",
  "types": "./src/index.d.ts"
}
