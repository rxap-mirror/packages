{
  "version": "0.0.8-dev.1",
  "name": "@rxap/n8n-nodes-neo4j",
  "description": "Provides a Neo4j node for n8n workflows, including basic authentication credentials. It allows to connect and interact with Neo4j databases within the n8n automation platform. Includes an init generator to handle peer dependencies.\n",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@nx/devkit": "20.5.0",
    "tslib": "2.6.2"
  },
  "peerDependencies": {
    "n8n-workflow": "^1.82.0"
  },
  "author": {
    "name": "Merzough Münker",
    "email": "mmuenker@digitaix.com"
  },
  "bugs": {
    "url": "https://gitlab.com/rxap/packages/-/issues",
    "email": "incoming+rxap-packages-14898188-issue-@incoming.gitlab.com"
  },
  "generators": "./generators.json",
  "homepage": "https:/gitlab.com/rxap/packages/packages/n8n/nodes/neo4j",
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "n8n-nodes-neo4j",
    "nodes",
    "packages",
    "rxap"
  ],
  "main": "./src/index.js",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "src/lib/neo4j.node.js"
    ],
    "credentials": [
      "src/lib/neo4j-basic-auth.credentials.js"
    ]
  },
  "publishConfig": {
    "access": "public",
    "directory": "../../../../dist/packages/n8n/nodes/neo4j"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/rxap/packages.git",
    "directory": "packages/n8n/nodes/neo4j"
  },
  "schematics": "./generators.json",
  "type": "commonjs",
  "typings": "./src/index.d.ts"
}
