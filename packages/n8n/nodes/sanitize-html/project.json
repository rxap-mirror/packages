{
  "name": "n8n-nodes-sanitize-html",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/n8n/nodes/sanitize-html/src",
  "projectType": "library",
  "tags": ["packages", "n8n", "nodes"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/n8n/nodes/sanitize-html",
        "main": "packages/n8n/nodes/sanitize-html/src/index.ts",
        "tsConfig": "packages/n8n/nodes/sanitize-html/tsconfig.lib.json",
        "assets": [
          "packages/n8n/nodes/sanitize-html/*.md",
          {
            "input": "./packages/n8n/nodes/sanitize-html/src/generators",
            "glob": "**/!(*.ts|*.js|*.json)",
            "output": "./src/generators"
          },
          {
            "input": "./packages/n8n/nodes/sanitize-html",
            "glob": "generators.json",
            "output": "."
          },
          {
            "input": "./packages/n8n/nodes/sanitize-html/src/lib",
            "glob": "**/*.(svg|json|png)",
            "output": "./src/lib"
          },
          "packages/n8n/nodes/sanitize-html/docs"
        ]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
