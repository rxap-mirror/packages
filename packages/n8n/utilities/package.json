{
  "version": "1.1.0-dev.0",
  "name": "@rxap/n8n-utilities",
  "description": "This package provides utility functions and classes for n8n nodes, including custom authentication methods (Bearer Auth, Oauth2 Proxy Auth, Base URL), a decorator for capturing execution errors, and base classes for creating nodes from OpenAPI specifications. It simplifies the process of building and integrating with REST APIs within the n8n workflow automation platform. The package offers tools for defining node properties based on OpenAPI schemas and handling different request body types.\n",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@nx/devkit": "20.4.2",
    "@rxap/utilities": "^16.4.2",
    "form-data": "^4.0.1",
    "openapi-types": "10.0.0",
    "tslib": "^2.3.0",
    "uuid": "8.3.2"
  },
  "peerDependencies": {
    "n8n-workflow": "^1.48.0"
  },
  "author": {
    "name": "Merzough Münker",
    "email": "mmuenker@digitaix.com"
  },
  "bugs": {
    "url": "https://gitlab.com/rxap/packages/-/issues",
    "email": "incoming+rxap-packages-14898188-issue-@incoming.gitlab.com"
  },
  "generators": "./generators.json",
  "homepage": "https:/gitlab.com/rxap/packages/packages/n8n/utilities",
  "keywords": [
    "n8n",
    "n8n-utilities",
    "packages",
    "rxap"
  ],
  "main": "./src/index.js",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [],
    "credentials": [
      "src/lib/HttpBearerAuth.credentials.js",
      "src/lib/Oauth2ProxyAuth.credentials.js",
      "src/lib/BaseUrl.credentials.js"
    ]
  },
  "publishConfig": {
    "access": "public",
    "directory": "../../../dist/packages/n8n/utilities"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/rxap/packages.git",
    "directory": "packages/n8n/utilities"
  },
  "type": "commonjs",
  "types": "./src/index.d.ts"
}
