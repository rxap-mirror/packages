{
  "name": "validator",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/validator/src",
  "projectType": "library",
  "tags": ["packages", "standalone", "scope:utilities"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/validator",
        "main": "packages/validator/src/index.ts",
        "tsConfig": "packages/validator/tsconfig.lib.json",
        "assets": ["packages/validator/*.md", "packages/validator/docs"]
      }
    },

    "lint": {
      "options": {
        "lintFilePatterns": ["packages/validator/**/*.ts"]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs validator {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },

    "test": {
      "options": {
        "jestConfig": "packages/validator/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },




    "typedoc": {
      "options": {
        "outputPath": [
          "dist/docs/packages/validator",
          "packages/validator/docs"
        ]
      }
    }
  }
}
