{
  "name": "ts-morph",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ts-morph/src",
  "projectType": "library",
  "tags": [
    "packages",
    "standalone",
    "scope:utilities"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/packages/ts-morph",
        "main": "packages/ts-morph/src/index.ts",
        "tsConfig": "packages/ts-morph/tsconfig.lib.json",
        "assets": [
          "packages/ts-morph/*.md",
          "packages/ts-morph/docs",
          {
            "input": "./packages/ts-morph",
            "glob": "migrations.json",
            "output": "."
          },
          {
            "input": "./packages/ts-morph/src/migrations",
            "glob": "**/!(*.ts|*.js|*.json)",
            "output": "./src/migrations"
          }
        ]
      }
    },


    "lint": {
      "options": {
        "lintFilePatterns": [
          "packages/ts-morph/**/*.ts"
        ]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs ts-morph {args.ver} {args.tag}",
      "dependsOn": [
        "build"
      ]
    }


  }
}
