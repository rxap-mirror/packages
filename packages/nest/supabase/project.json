{
  "name": "nest-supabase",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/nest/supabase/src",
  "projectType": "library",
  "tags": ["nest", "libs", "packages"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/nest/supabase",
        "tsConfig": "packages/nest/supabase/tsconfig.lib.json",
        "packageJson": "packages/nest/supabase/package.json",
        "main": "packages/nest/supabase/src/index.ts",
        "assets": ["packages/nest/supabase/*.md", "packages/nest/supabase/docs"]
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/nest/supabase/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "development"
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs nest-supabase {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/nest/supabase/jest.config.ts"
      }
    },







    "typedoc": {
      "options": {
        "outputPath": [
          "dist/docs/packages/nest/supabase",
          "packages/nest/supabase/docs"
        ]
      }
    }
  }
}
