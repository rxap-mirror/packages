{
  "name": "nest-socket-io-client",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/nest/socket-io-client/src",
  "projectType": "library",
  "tags": ["nest", "packages", "scope:integration"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/nest/socket-io-client",
        "tsConfig": "packages/nest/socket-io-client/tsconfig.lib.json",
        "packageJson": "packages/nest/socket-io-client/package.json",
        "main": "packages/nest/socket-io-client/src/index.ts",
        "assets": [
          "packages/nest/socket-io-client/*.md",
          "packages/nest/socket-io-client/docs",
          "packages/nest/socket-io-client/compodoc"
        ]
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/nest/socket-io-client/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "options": {
        "lintFilePatterns": ["packages/nest/socket-io-client/**/*.ts"]
      }
    }


  }
}
