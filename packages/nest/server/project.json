{
  "name": "nest-server",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/nest/server/src",
  "projectType": "library",
  "tags": ["nest", "packages", "scope:core"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/nest/server",
        "tsConfig": "packages/nest/server/tsconfig.lib.json",
        "packageJson": "packages/nest/server/package.json",
        "main": "packages/nest/server/src/index.ts",
        "assets": [
          "packages/nest/server/*.md",
          "packages/nest/server/docs",
          "packages/nest/server/compodoc"
        ]
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/nest/server/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "options": {
        "lintFilePatterns": ["packages/nest/server/**/*.ts"]
      }
    },

    "test": {
      "options": {
        "jestConfig": "packages/nest/server/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    }
  }
}
