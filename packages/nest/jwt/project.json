{
  "name": "nest-jwt",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/nest/jwt/src",
  "projectType": "library",
  "tags": ["nest", "packages", "scope:integration"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/nest/jwt",
        "tsConfig": "packages/nest/jwt/tsconfig.lib.json",
        "packageJson": "packages/nest/jwt/package.json",
        "main": "packages/nest/jwt/src/index.ts",
        "assets": [
          "packages/nest/jwt/*.md",
          "packages/nest/jwt/docs",
          "packages/nest/jwt/compodoc"
        ]
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/nest/jwt/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "options": {
        "lintFilePatterns": ["packages/nest/jwt/**/*.ts"]
      }
    },

    "test": {
      "options": {
        "jestConfig": "packages/nest/jwt/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    }
  }
}
