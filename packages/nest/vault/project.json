{
  "name": "nest-vault",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/nest/vault/src",
  "projectType": "library",
  "tags": ["nest", "packages"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/nest/vault",
        "tsConfig": "packages/nest/vault/tsconfig.lib.json",
        "packageJson": "packages/nest/vault/package.json",
        "main": "packages/nest/vault/src/index.ts",
        "assets": [
          "packages/nest/vault/*.md",
          "packages/nest/vault/docs",
          "packages/nest/vault/compodoc"
        ]
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/nest/vault/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "development"
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs nest-vault {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/nest/vault/jest.config.ts"
      }
    },
    "fix-dependencies": {
      "executor": "@rxap/plugin-library:fix-dependencies",
      "outputs": ["{projectRoot}/package.json"],
      "options": {
        "strict": true,
        "onlyDependencies": false,
        "dependencies": ["node-vault"]
      }
    }
  }
}
