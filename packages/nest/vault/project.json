{
  "name": "nest-vault",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/nest/vault/src",
  "projectType": "library",
  "tags": ["nest", "packages"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/nest/vault",
        "tsConfig": "packages/nest/vault/tsconfig.lib.json",
        "packageJson": "packages/nest/vault/package.json",
        "main": "packages/nest/vault/src/index.ts",
        "assets": ["packages/nest/vault/*.md", "packages/nest/vault/docs"]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs nest-vault {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/nest/vault/jest.config.ts"
      }
    },
    "index-export": {},
    "update-dependencies": {
      "executor": "@rxap/plugin-library:update-dependencies"
    },
    "update-package-group": {
      "executor": "@rxap/plugin-library:update-package-group"
    },
    "readme": {
      "executor": "@rxap/plugin-library:readme"
    },
    "fix-dependencies": {
      "executor": "@rxap/plugin-library:run-generator",
      "outputs": ["{projectRoot}/package.json"],
      "options": {
        "generator": "@rxap/plugin-library:fix-dependencies",
        "options": {
          "strict": true,
          "onlyDependencies": false,
          "dependencies": [ "node-vault" ]
        }
      }
    },
    "linking": {},
    "check-version": {
      "executor": "@rxap/plugin-library:check-version",
      "options": {
        "packageName": "@nestjs/core"
      }
    },
    "typedoc": {
      "options": {
        "outputPath": [
          "dist/docs/packages/nest/vault",
          "packages/nest/vault/docs"
        ]
      }
    }
  }
}
