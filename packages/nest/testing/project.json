{
  "name": "nest-testing",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/nest/testing/src",
  "projectType": "library",
  "tags": ["nest", "packages"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/nest/testing",
        "tsConfig": "packages/nest/testing/tsconfig.lib.json",
        "packageJson": "packages/nest/testing/package.json",
        "main": "packages/nest/testing/src/index.ts",
        "assets": [
          "packages/nest/testing/*.md",
          "packages/nest/testing/docs",
          "packages/nest/testing/compodoc"
        ]
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/nest/testing/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "development"
    }
  }
}
