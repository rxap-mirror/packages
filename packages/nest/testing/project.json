{
  "name": "nest-testing",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/nest/testing/src",
  "projectType": "library",
  "tags": ["nest", "packages"],
  "targets": {

    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/nest/testing",
        "tsConfig": "packages/nest/testing/tsconfig.lib.json",
        "packageJson": "packages/nest/testing/package.json",
        "main": "packages/nest/testing/src/index.ts",
        "assets": ["packages/nest/testing/*.md", "packages/nest/testing/docs"]
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/nest/testing/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "development"
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs nest-testing {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/nest/testing/jest.config.ts"
      }
    },






    "typedoc": {
      "options": {
        "outputPath": [
          "dist/docs/packages/nest/testing",
          "packages/nest/testing/docs"
        ]
      }
    }
  }
}
