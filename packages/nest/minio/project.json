{
  "name": "nest-minio",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/nest/minio/src",
  "projectType": "library",
  "tags": ["nest", "packages", "scope:integration"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/nest/minio",
        "tsConfig": "packages/nest/minio/tsconfig.lib.json",
        "packageJson": "packages/nest/minio/package.json",
        "main": "packages/nest/minio/src/index.ts",
        "assets": [
          "packages/nest/minio/*.md",
          "packages/nest/minio/docs",
          "packages/nest/minio/compodoc"
        ]
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/nest/minio/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "options": {
        "lintFilePatterns": ["packages/nest/minio/**/*.ts"]
      }
    }
  }
}
