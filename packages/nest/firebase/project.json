{
  "name": "nest-firebase",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/nest/firebase/src",
  "projectType": "library",
  "tags": ["nest", "packages", "scope:integration"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/nest/firebase",
        "tsConfig": "packages/nest/firebase/tsconfig.lib.json",
        "packageJson": "packages/nest/firebase/package.json",
        "main": "packages/nest/firebase/src/index.ts",
        "assets": [
          "packages/nest/firebase/*.md",
          "packages/nest/firebase/docs",
          "packages/nest/firebase/compodoc"
        ]
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/nest/firebase/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "options": {
        "lintFilePatterns": ["packages/nest/firebase/**/*.ts"]
      }
    }


  }
}
