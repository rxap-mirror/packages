{
  "name": "nest-firebase",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/nest/firebase/src",
  "projectType": "library",
  "tags": ["nest", "packages", "scope:integration"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/nest/firebase",
        "tsConfig": "packages/nest/firebase/tsconfig.lib.json",
        "packageJson": "packages/nest/firebase/package.json",
        "main": "packages/nest/firebase/src/index.ts",
        "assets": ["packages/nest/firebase/*.md", "packages/nest/firebase/docs"]
      }
    },
    "check-version": {
      "options": {
        "packageName": "@nestjs/core"
      }
    },
    "fix-dependencies": {
      "options": {
        "options": {
          "strict": true,
          "onlyDependencies": false
        },
        "generator": "@rxap/plugin-library:fix-dependencies"
      },
      "executor": "@rxap/plugin-library:run-generator",
      "outputs": ["{projectRoot}/package.json"]
    },
    "lint": {
      "options": {
        "lintFilePatterns": ["packages/nest/firebase/**/*.ts"]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs nest-firebase {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },
    "readme": {},
    "test": {
      "options": {
        "jestConfig": "packages/nest/firebase/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "update-dependencies": {},
    "update-package-group": {},
    "linking": {},
    "index-export": {},
    "typedoc": {
      "options": {
        "outputPath": [
          "dist/docs/packages/nest/firebase",
          "packages/nest/firebase/docs"
        ]
      }
    }
  }
}
