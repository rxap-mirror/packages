{
  "name": "nest-open-api",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/nest/open-api/src",
  "projectType": "library",
  "tags": ["nest", "packages", "scope:integration"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/nest/open-api",
        "tsConfig": "packages/nest/open-api/tsconfig.lib.json",
        "packageJson": "packages/nest/open-api/package.json",
        "main": "packages/nest/open-api/src/index.ts",
        "assets": [
          "packages/nest/open-api/*.md",
          "packages/nest/open-api/docs",
          "packages/nest/open-api/compodoc"
        ]
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/nest/open-api/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "options": {
        "lintFilePatterns": ["packages/nest/open-api/**/*.ts"]
      }
    },

    "test": {
      "options": {
        "jestConfig": "packages/nest/open-api/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    }
  }
}
