{
  "name": "nest-utilities",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/nest/utilities/src",
  "projectType": "library",
  "tags": ["nest", "packages", "scope:utilities"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/nest/utilities",
        "tsConfig": "packages/nest/utilities/tsconfig.lib.json",
        "packageJson": "packages/nest/utilities/package.json",
        "main": "packages/nest/utilities/src/index.ts",
        "assets": [
          "packages/nest/utilities/*.md",
          "packages/nest/utilities/docs",
          "packages/nest/utilities/compodoc"
        ]
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/nest/utilities/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "options": {
        "lintFilePatterns": ["packages/nest/utilities/**/*.ts"]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs nest-utilities {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },
    "test": {
      "options": {
        "jestConfig": "packages/nest/utilities/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    }
  }
}
