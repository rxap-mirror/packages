{
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      {
        "runtime": "node --version"
      }
    ],
    "typescript": [
      "{projectRoot}/**/*.ts",
      "{projectRoot}/tsconfig.json",
      "{projectRoot}/tsconfig.*.json"
    ],
    "test": [
      "typescript",
      "{projectRoot}/src/**/*",
      "!{projectRoot}/tsconfig.lib.json",
      "!{projectRoot}/tsconfig.lib.prod.json"
    ],
    "production": [
      "typescript",
      "{projectRoot}/src/**/*",
      "!{projectRoot}/**/*.{spec,stories,cy}.ts",
      "!{projectRoot}/jest.config.ts",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/cypress/**/*",
      "!{projectRoot}/**/*.cy.[jt]s?(x)",
      "!{projectRoot}/cypress.config.[jt]s",
      "!{projectRoot}/**/*.stories.@(js|jsx|ts|tsx|mdx)",
      "!{projectRoot}/.storybook/**/*",
      "!{projectRoot}/tsconfig.storybook.json"
    ],
    "build": [
      "production",
      "{projectRoot}/package.json",
      "{projectRoot}/collection.json",
      "{projectRoot}/generators.json",
      "{projectRoot}/executors.json"
    ]
  },
  "targetDefaults": {
    "test": {
      "cache": true,
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}",
        "{workspaceRoot}/junit/{projectRoot}",
        "{projectRoot}/coverage"
      ],
      "inputs": [
        "test",
        "^test",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/jest.preset.ts",
        {
          "env": "JEST_JUNIT_OUTPUT_DIR"
        }
      ],
      "options": {
        "passWithNoTests": true,
        "silent": true,
        "coverageReporters": ["json", "html"],
        "codeCoverage": true
      }
    },
    "serve": {
      "dependsOn": ["build-info", "^copy-open-api-sdk", "^generate-open-api"]
    },
    "copy-open-api-sdk": {
      "dependsOn": ["^generate-open-api"],
      "executor": "@rxap/plugin-open-api:copy-client-sdk",
      "outputs": ["{projectRoot}/src/lib/openapi"],
      "cache": true
    },
    "index-json-schema": {
      "inputs": [
        "{projectRoot}/src/**/template.schema.json",
        "{projectRoot}/src/**/*.schema.json"
      ],
      "outputs": [
        "{projectRoot}/template.schema.json",
        "{projectRoot}/schematic-input.schema.json"
      ],
      "executor": "@rxap/plugin-library:run-generator",
      "options": {
        "generator": "@rxap/plugin-library:index-json-schema"
      },
      "cache": true
    },
    "bundle-json-schema": {
      "dependsOn": ["index-json-schema"],
      "inputs": [
        "{projectRoot}/src/**/template.schema.json",
        "{projectRoot}/src/**/*.schema.json"
      ],
      "outputs": ["{projectRoot}/src/**/schema.json"],
      "executor": "@rxap/plugin-library:run-generator",
      "options": {
        "generator": "@rxap/plugin-library:bundle-json-schema"
      },
      "cache": true
    },
    "build": {
      "dependsOn": [
        "^build",
        "readme",
        "compodoc",
        "typedoc",
        "index-export",
        "check-version",
        "build-tailwind",
        "generate-package-json",
        "check-ng-package",
        "localazy-download",
        "build-info",
        "expose-as-schematic",
        "copy-open-api-sdk",
        "^copy-open-api-sdk",
        "^generate-open-api",
        "bundle-json-schema",
        "^index-export"
      ],
      "inputs": ["build", "^build"],
      "cache": true
    },
    "expose-as-schematic": {
      "executor": "@rxap/plugin-library:run-generator",
      "options": {
        "generator": "@rxap/plugin-library:expose-as-schematic"
      },
      "outputs": [
        "{projectRoot}/generators.json",
        "{projectRoot}/src/generators/**/index.ts"
      ],
      "inputs": [
        "{projectRoot}/generators.json",
        "{projectRoot}/src/generators/**/schema.json"
      ],
      "cache": true
    },
    "extract-i18n": {
      "outputs": ["{options.outputPath}"],
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "format": "xliff2"
      },
      "input": ["production", "^production"],
      "cache": true
    },
    "component-test": {
      "executor": "@nx/cypress:cypress",
      "inputs": ["default", "^production"],
      "configurations": {
        "open": {
          "watch": true
        }
      },
      "options": {
        "testingType": "component",
        "skipServe": true,
        "devServerTarget": "angular:build:development"
      },
      "cache": true
    },
    "docker-save": {
      "dependsOn": ["docker"],
      "executor": "@rxap/plugin-docker:save"
    },
    "config": {
      "executor": "@rxap/plugin-application:config"
    },
    "deploy": {
      "dependsOn": ["build", "i18n-index-html"],
      "inputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "cache": true
    },
    "i18n-index-html": {
      "dependsOn": ["build"],
      "executor": "@rxap/plugin-application:i18n",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/index.html"],
      "inputs": ["{projectRoot}/project.json"],
      "cache": true
    },
    "ci-info": {
      "cache": true
    },
    "@nx/jest:jest": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}",
        "{workspaceRoot}/junit/{projectRoot}",
        "{projectRoot}/coverage"
      ],
      "inputs": [
        "test",
        "^test",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/jest.preset.ts",
        {
          "env": "JEST_JUNIT_OUTPUT_DIR"
        }
      ],
      "options": {
        "passWithNoTests": true,
        "silent": true,
        "coverageReporters": ["json", "html"],
        "codeCoverage": true
      },
      "cache": true,
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "swagger-build": {
      "cache": true
    },
    "swagger-generate": {
      "cache": true
    },
    "generate-package-json": {
      "cache": true
    },
    "generate-open-api": {
      "cache": true
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": [
        "^build",
        "readme",
        "compodoc",
        "index-export",
        "check-version",
        "build-tailwind",
        "generate-package-json",
        "check-ng-package",
        "localazy-download",
        "build-info",
        "expose-as-schematic",
        "copy-open-api-sdk",
        "^copy-open-api-sdk",
        "^generate-open-api",
        "bundle-json-schema",
        "^index-export"
      ],
      "inputs": ["production", "^production"]
    },
    "copy-client-sdk": {
      "cache": true
    },
    "build-storybook": {
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/.storybook/**/*",
        "{projectRoot}/tsconfig.storybook.json"
      ]
    },
    "@nx/angular:package": {
      "cache": true,
      "dependsOn": [
        "index-export",
        "^index-export",
        "^build",
        "check-version",
        "build-tailwind",
        "check-ng-package"
      ],
      "inputs": ["production", "^production"]
    },
    "@nx/js:swc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/angular:ng-packagr-lite": {
      "dependsOn": [
        "index-export",
        "^index-export",
        "^build",
        "check-version",
        "build-tailwind",
        "check-ng-package"
      ],
      "inputs": ["production", "^production"],
      "cache": true
    },



    "lint": {
      "outputs": ["{options.outputFile}"],
      "inputs": [
        "default",
        "{projectRoot}/.eslintrc.json",
        "{projectRoot}/.eslintignore",
        "{workspaceRoot}/.eslintrc.json"
      ],
      "options": {
        "quiet": true
      },
      "cache": true
    },
    "docker": {
      "options": {
        "imageRegistry": "registry.gitlab.com",
        "imageName": "rxap/packages",
        "dockerfile": "shared/angular/Dockerfile"
      }
    }
  },
  "generators": {
    "@nx/angular:application": {
      "style": "scss",
      "linter": "eslint",
      "unitTestRunner": "jest",
      "e2eTestRunner": "none",
      "tags": "angular,ngx",
      "prefix": "rxap",
      "standalone": true,
      "addTailwind": true,
      "routing": true
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "jest",
      "publishable": true,
      "addTailwind": true,
      "changeDetection": "OnPush",
      "standalone": true,
      "style": "scss",
      "directory": "angular",
      "tags": "angular,ngx",
      "prefix": "rxap",
      "skipModule": true
    },
    "@nx/plugin:plugin": {
      "directory": "plugin",
      "publishable": true,
      "tags": "plugin,nx,nx-plugin"
    },
    "@nx/js:library": {
      "unitTestRunner": "jest",
      "publishable": true
    },
    "@nx/angular:component": {
      "style": "scss",
      "standalone": true
    },
    "@nx/nest:library": {
      "directory": "nest",
      "tags": "nest",
      "publishable": true
    },
    "@nx/angular:directive": {
      "standalone": true,
      "skipTests": true
    },
    "@nx/nest:application": {
      "e2eTestRunner": "none",
      "tags": "nest",
      "strict": true
    },
    "@nx/plugin:executor": {
      "unitTestRunner": "none"
    },
    "@nx/plugin:generator": {
      "unitTestRunner": "none"
    },
    "@nx/angular:library-secondary-entry-point": {
      "skipModule": true
    },
    "@nx/angular:host": {
      "style": "scss",
      "linter": "eslint",
      "unitTestRunner": "jest",
      "e2eTestRunner": "none",
      "tags": "angular,ngx",
      "prefix": "rxap",
      "standalone": true,
      "addTailwind": true,
      "name": "shell",
      "directory": "user-interface/shell"
    },
    "@nx/angular:remote": {
      "style": "scss",
      "linter": "eslint",
      "unitTestRunner": "jest",
      "e2eTestRunner": "none",
      "tags": "angular,ngx",
      "prefix": "rxap",
      "standalone": true,
      "addTailwind": true,
      "host": "shell",
      "directory": "user-interface/feature"
    }
  },
  "workspaceLayout": {
    "appsDir": "applications",
    "libsDir": "packages"
  },
  "cli": {
    "packageManager": "yarn"
  },
  "parallel": 8,
  "useInferencePlugins": false,
  "defaultBase": "development",
  "release": {
    "version": {
      "preVersionCommand": "yarn dlx nx run-many -t build"
    }
  },
  "useLegacyCache": true,
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    "./packages/plugin/library/src/plugin.ts",
    "./packages/plugin/angular/src/library.ts",
    "./packages/plugin/angular/src/application.ts",
    "./packages/plugin/nestjs/src/application.ts",
    "./packages/plugin/compodoc/src/plugin.ts",
    "./packages/plugin/typedoc/src/plugin.ts",
    "./packages/plugin/localazy/src/plugin.ts",
    "./packages/plugin/docker/src/plugin.ts"
  ]
}
