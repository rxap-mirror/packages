{
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      {
        "runtime": "node --version"
      }
    ],
    "typescript": [
      "{projectRoot}/**/*.ts",
      "{projectRoot}/tsconfig.json",
      "{projectRoot}/tsconfig.*.json"
    ],
    "test": [
      "typescript",
      "{projectRoot}/src/**/*",
      "!{projectRoot}/tsconfig.lib.json",
      "!{projectRoot}/tsconfig.lib.prod.json"
    ],
    "production": [
      "typescript",
      "{projectRoot}/src/**/*",
      "!{projectRoot}/**/*.{spec,stories,cy}.ts",
      "!{projectRoot}/jest.config.ts",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/cypress/**/*",
      "!{projectRoot}/**/*.cy.[jt]s?(x)",
      "!{projectRoot}/cypress.config.[jt]s"
    ],
    "build": [
      "production",
      "{projectRoot}/package.json",
      "{projectRoot}/collection.json",
      "{projectRoot}/generators.json",
      "{projectRoot}/executors.json"
    ]
  },
  "targetDefaults": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore"
      ],
      "cache": true
    },
    "fix-dependencies": {
      "inputs": ["production", "^production", "{projectRoot}/package.json"],
      "dependsOn": ["^fix-dependencies"],
      "executor": "@rxap/plugin-library:run-generator",
      "outputs": ["{projectRoot}/package.json"],
      "options": {
        "generator": "@rxap/plugin-library:fix-dependencies",
        "options": {
          "strict": true
        }
      }
    },
    "update-package-group": {
      "executor": "@rxap/plugin-library:update-package-group",
      "dependsOn": ["update-dependencies", "^update-dependencies"],
      "inputs": ["production", "{projectRoot}/package.json"],
      "outputs": ["{projectRoot}/package.json"]
    },
    "update-dependencies": {
      "executor": "@rxap/plugin-library:update-dependencies",
      "outputs": ["{projectRoot}/package.json"],
      "inputs": ["{workspaceRoot}/package.json", "{projectRoot}/package.json"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}",
        "{workspaceRoot}/junit/{projectRoot}",
        "{workspaceRoot}/{projectRoot}/coverage"
      ],
      "inputs": [
        "test",
        "^test",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/jest.preset.ts",
        {
          "env": "JEST_JUNIT_OUTPUT_DIR"
        }
      ],
      "options": {
        "passWithNoTests": true,
        "silent": true,
        "coverageReporters": ["json"],
        "codeCoverage": true
      },
      "cache": true
    },
    "serve": {
      "dependsOn": ["build-info", "^copy-open-api-sdk", "^generate-open-api"]
    },
    "copy-open-api-sdk": {
      "dependsOn": ["^generate-open-api"],
      "executor": "@rxap/plugin-open-api:copy-client-sdk",
      "outputs": ["{projectRoot}/src/lib/openapi"],
      "cache": true
    },
    "linking": {
      "executor": "@rxap/plugin-library:node-modules-linking",
      "dependsOn": ["build", "^linking"],
      "inputs": [
        {
          "env": "CI_JOB_ID"
        }
      ]
    },
    "index-json-schema": {
      "inputs": [
        "{projectRoot}/src/**/template.schema.json",
        "{projectRoot}/src/**/*.schema.json"
      ],
      "outputs": [
        "{workspaceRoot}/{projectRoot}/template.schema.json",
        "{workspaceRoot}/{projectRoot}/schematic-input.schema.json"
      ],
      "executor": "@rxap/plugin-library:run-generator",
      "options": {
        "generator": "@rxap/plugin-library:index-json-schema"
      },
      "cache": true
    },
    "bundle-json-schema": {
      "dependsOn": ["index-json-schema"],
      "inputs": [
        "{projectRoot}/src/**/template.schema.json",
        "{projectRoot}/src/**/*.schema.json"
      ],
      "outputs": ["{workspaceRoot}/{projectRoot}/src/**/schema.json"],
      "executor": "@rxap/plugin-library:run-generator",
      "options": {
        "generator": "@rxap/plugin-library:bundle-json-schema"
      },
      "cache": true
    },
    "build": {
      "dependsOn": [
        "^build",
        "readme",
        "index-export",
        "check-version",
        "build-tailwind",
        "generate-package-json",
        "check-ng-package",
        "localazy-download",
        "build-info",
        "expose-as-schematic",
        "copy-open-api-sdk",
        "^copy-open-api-sdk",
        "^generate-open-api",
        "bundle-json-schema",
        "^index-export"
      ],
      "inputs": ["build", "^build"],
      "cache": true
    },
    "localazy-download": {
      "executor": "@rxap/plugin-localazy:download",
      "inputs": [
        {
          "runtime": "date"
        },
        {
          "env": "CI_COMMIT_TIMESTAMP"
        },
        {
          "env": "CI_COMMIT_SHA"
        },
        {
          "env": "CI_JOB_ID"
        },
        {
          "env": "CI_PIPELINE_ID"
        }
      ],
      "outputs": ["{projectRoot}/src/i18n"],
      "cache": true
    },
    "expose-as-schematic": {
      "executor": "@rxap/plugin-library:run-generator",
      "options": {
        "generator": "@rxap/plugin-library:expose-as-schematic"
      },
      "outputs": [
        "{projectRoot}/generators.json",
        "{projectRoot}/src/generators/**/index.ts"
      ],
      "inputs": [
        "{projectRoot}/generators.json",
        "{projectRoot}/src/generators/**/schema.json"
      ],
      "cache": true
    },
    "extract-i18n": {
      "outputs": ["{options.outputPath}"],
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "format": "xliff2"
      },
      "input": ["production", "^production"],
      "cache": true
    },
    "build-tailwind": {
      "executor": "@rxap/plugin-angular:tailwind",
      "configurations": {
        "production": {
          "minify": true
        }
      },
      "dependsOn": [
        {
          "target": "build",
          "projects": ["browser-tailwind"]
        }
      ],
      "inputs": [
        "{projectRoot}/**/*.html",
        "{projectRoot}/**/*.scss",
        "{projectRoot}/**/*.css"
      ],
      "outputs": ["{projectRoot}/theme.css"],
      "cache": true
    },
    "readme": {
      "executor": "@rxap/plugin-library:readme",
      "inputs": [
        "{projectRoot}/README.md.handlebars",
        "{projectRoot}/GETSTARTED.md",
        "{projectRoot}/GUIDES.md",
        "{projectRoot}/package.json",
        "{projectRoot}/collection.json",
        "{projectRoot}/generators.json",
        "{projectRoot}/executors.json",
        "{projectRoot}/builders.json"
      ],
      "outputs": ["{projectRoot}/README.md"],
      "cache": true
    },
    "docker": {
      "executor": "@rxap/plugin-docker:build",
      "inputs": ["production", "^production", "{projectRoot}/package.json"],
      "dependsOn": ["build"],
      "options": {
        "imageName": "rxap/packages",
        "imageRegistry": "registry.gitlab.com"
      },
      "cache": true
    },
    "check-version": {
      "executor": "@rxap/plugin-library:check-version",
      "inputs": ["{projectRoot}/package.json", "{workspaceRoot}/package.json"],
      "cache": true
    },
    "component-test": {
      "executor": "@nx/cypress:cypress",
      "inputs": ["default", "^production"],
      "configurations": {
        "open": {
          "watch": true
        }
      },
      "options": {
        "testingType": "component",
        "skipServe": true,
        "devServerTarget": "angular:build:development"
      },
      "cache": true
    },
    "docker-save": {
      "dependsOn": ["docker"],
      "executor": "@rxap/plugin-docker:save"
    },
    "check-ng-package": {
      "executor": "@rxap/plugin-angular:check-ng-package",
      "inputs": ["{projectRoot}/ng-package.json", "{projectRoot}/package.json"],
      "cache": true
    },
    "config": {
      "executor": "@rxap/plugin-application:config"
    },
    "index-export": {
      "executor": "@rxap/plugin-library:run-generator",
      "outputs": ["{workspaceRoot}/{projectRoot}/src/index.ts"],
      "options": {
        "generator": "@rxap/plugin-library:index-export"
      },
      "inputs": ["production"],
      "cache": true
    },
    "localazy-upload": {
      "dependsOn": ["extract-i18n"],
      "inputs": ["{projectRoot}/src/i18n/messages.xlf"],
      "cache": true
    },
    "deploy": {
      "dependsOn": ["build", "i18n-index-html"],
      "inputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "cache": true
    },
    "i18n-index-html": {
      "dependsOn": ["build"],
      "executor": "@rxap/plugin-application:i18n",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/index.html"],
      "inputs": ["{workspaceRoot}/{projectRoot}/project.json"],
      "cache": true
    },
    "compodoc": {
      "executor": "@rxap/plugin-compodoc:build",
      "defaultConfiguration": "html",
      "outputs": ["{options.outputPath}"],
      "inputs": ["production", "^production"],
      "configurations": {
        "json": {
          "exportFormat": "json"
        },
        "html": {
          "exportFormat": "html"
        }
      },
      "cache": true
    },
    "typedoc": {
      "cache": true
    },
    "ci-info": {
      "cache": true
    },
    "@nx/jest:jest": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}",
        "{workspaceRoot}/junit/{projectRoot}",
        "{workspaceRoot}/{projectRoot}/coverage"
      ],
      "inputs": [
        "test",
        "^test",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/jest.preset.ts",
        {
          "env": "JEST_JUNIT_OUTPUT_DIR"
        }
      ],
      "options": {
        "passWithNoTests": true,
        "silent": true,
        "coverageReporters": ["json"],
        "codeCoverage": true
      },
      "cache": true,
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "@nx/eslint:lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore"
      ],
      "cache": true
    },
    "swagger-build": {
      "cache": true
    },
    "swagger-generate": {
      "cache": true
    },
    "generate-package-json": {
      "cache": true
    },
    "generate-open-api": {
      "cache": true
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "copy-client-sdk": {
      "cache": true
    }
  },
  "generators": {
    "@nx/angular:application": {
      "style": "scss",
      "linter": "eslint",
      "unitTestRunner": "jest",
      "e2eTestRunner": "none",
      "tags": "angular,ngx",
      "prefix": "rxap",
      "standalone": true,
      "addTailwind": true,
      "routing": true
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "jest",
      "publishable": true,
      "addTailwind": true,
      "changeDetection": "OnPush",
      "standalone": true,
      "style": "scss",
      "directory": "angular",
      "tags": "angular,ngx",
      "prefix": "rxap",
      "skipModule": true
    },
    "@nx/plugin:plugin": {
      "directory": "plugin",
      "publishable": true,
      "tags": "plugin,nx,nx-plugin"
    },
    "@nx/js:library": {
      "unitTestRunner": "jest",
      "publishable": true
    },
    "@nx/angular:component": {
      "style": "scss",
      "standalone": true
    },
    "@nx/nest:library": {
      "directory": "nest",
      "tags": "nest",
      "publishable": true
    },
    "@nx/angular:directive": {
      "standalone": true,
      "skipTests": true
    },
    "@nx/nest:application": {
      "e2eTestRunner": "none",
      "tags": "nest",
      "strict": true
    },
    "@nx/plugin:executor": {
      "unitTestRunner": "none"
    },
    "@nx/plugin:generator": {
      "unitTestRunner": "none"
    },
    "@nx/angular:library-secondary-entry-point": {
      "skipModule": true
    },
    "@nx/angular:host": {
      "style": "scss",
      "linter": "eslint",
      "unitTestRunner": "jest",
      "e2eTestRunner": "none",
      "tags": "angular,ngx",
      "prefix": "rxap",
      "standalone": true,
      "addTailwind": true,
      "name": "shell",
      "directory": "user-interface/shell"
    },
    "@nx/angular:remote": {
      "style": "scss",
      "linter": "eslint",
      "unitTestRunner": "jest",
      "e2eTestRunner": "none",
      "tags": "angular,ngx",
      "prefix": "rxap",
      "standalone": true,
      "addTailwind": true,
      "host": "shell",
      "directory": "user-interface/feature"
    }
  },
  "workspaceLayout": {
    "appsDir": "applications",
    "libsDir": "packages"
  },
  "cli": {
    "packageManager": "yarn"
  },
  "parallel": 8,
  "useInferencePlugins": false,
  "defaultBase": "development",
  "release": {
    "version": {
      "preVersionCommand": "yarn dlx nx run-many -t build"
    }
  }
}
