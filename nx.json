{
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      {
        "runtime": "node --version"
      }
    ],
    "typescript": [
      "{projectRoot}/**/*.ts",
      "{projectRoot}/tsconfig.json",
      "{projectRoot}/tsconfig.*.json"
    ],
    "test": [
      "typescript",
      "{projectRoot}/src/**/*",
      "!{projectRoot}/tsconfig.lib.json",
      "!{projectRoot}/tsconfig.lib.prod.json"
    ],
    "production": [
      "typescript",
      "{projectRoot}/src/**/*",
      "!{projectRoot}/**/*.{spec,stories,cy}.ts",
      "!{projectRoot}/jest.config.ts",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/cypress/**/*",
      "!{projectRoot}/**/*.cy.[jt]s?(x)",
      "!{projectRoot}/cypress.config.[jt]s",
      "!{projectRoot}/**/*.stories.@(js|jsx|ts|tsx|mdx)",
      "!{projectRoot}/.storybook/**/*",
      "!{projectRoot}/tsconfig.storybook.json"
    ],
    "build": [
      "production",
      "{projectRoot}/package.json",
      "{projectRoot}/collection.json",
      "{projectRoot}/generators.json",
      "{projectRoot}/executors.json"
    ]
  },
  "defaultProject": "workspace",
  "targetDefaults": {
    "serve": {
      "dependsOn": ["build-info", "^copy-open-api-sdk", "^generate-open-api"]
    },
    "extract-i18n": {
      "outputs": ["{options.outputPath}"],
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "format": "xliff2"
      },
      "input": ["production", "^production"],
      "cache": true
    },
    "component-test": {
      "executor": "@nx/cypress:cypress",
      "inputs": ["default", "^production"],
      "configurations": {
        "open": {
          "watch": true
        }
      },
      "options": {
        "testingType": "component",
        "skipServe": true,
        "devServerTarget": "angular:build:development"
      },
      "cache": true
    },
    "config": {
      "executor": "@rxap/plugin-application:config"
    },
    "build-storybook": {
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/.storybook/**/*",
        "{projectRoot}/tsconfig.storybook.json"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "typedoc",
        "compodoc",
        "build-tailwind",
        "generate-package-json",
        "build-info",
        "copy-open-api-sdk",
        "bundle-json-schema"
      ],
      "cache": true,
      "inputs": ["production", "^production"]
    },
    "copy-open-api-sdk": {
      "dependsOn": ["^generate-open-api"],
      "executor": "@rxap/plugin-open-api:copy-open-api-sdk",
      "outputs": ["{projectRoot}/src/lib/openapi"],
      "cache": true
    },
    "test": {
      "cache": true,
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}",
        "{workspaceRoot}/junit/{projectRoot}",
        "{projectRoot}/coverage"
      ],
      "inputs": [
        "test",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/jest.preset.ts",
        "{projectRoot}/jest.config.ts",
        {
          "env": "JEST_JUNIT_OUTPUT_DIR"
        }
      ],
      "options": {
        "passWithNoTests": true,
        "silent": true,
        "coverageReporters": ["json", "html"],
        "codeCoverage": true
      }
    },
    "lint": {
      "outputs": ["{options.outputFile}"],
      "inputs": [
        "default",
        "{projectRoot}/.eslintrc.json",
        "{projectRoot}/.eslintignore",
        "{workspaceRoot}/.eslintrc.json"
      ],
      "options": {
        "quiet": true
      },
      "cache": true
    },
    "docker": {
      "options": {
        "imageRegistry": "registry.gitlab.com",
        "imageName": "rxap/packages",
        "dockerfile": "shared/angular/Dockerfile"
      }
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"]
    },
    "fix-dependencies": {
      "dependsOn": ["^fix-dependencies"]
    },
    "@nx/angular:ng-packagr-lite": {
      "dependsOn": [
        "^build",
        "build-tailwind"
      ],
      "inputs": ["production", "^production"]
    },
    "build-tailwind": {
      "dependsOn": [
        {
          "target": "build",
          "projects": ["browser-tailwind"]
        }
      ]
    },
    "check-version": {
      "cache": true
    }
  },
  "generators": {
    "@nx/angular:application": {
      "style": "scss",
      "linter": "eslint",
      "unitTestRunner": "jest",
      "e2eTestRunner": "none",
      "tags": "angular,ngx",
      "prefix": "rxap",
      "standalone": true,
      "addTailwind": true,
      "routing": true
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "jest",
      "publishable": true,
      "addTailwind": true,
      "changeDetection": "OnPush",
      "standalone": true,
      "style": "scss",
      "directory": "angular",
      "tags": "angular,ngx",
      "prefix": "rxap",
      "skipModule": true
    },
    "@nx/plugin:plugin": {
      "directory": "plugin",
      "publishable": true,
      "tags": "plugin,nx,nx-plugin"
    },
    "@nx/js:library": {
      "unitTestRunner": "jest",
      "publishable": true
    },
    "@nx/angular:component": {
      "style": "scss",
      "standalone": true
    },
    "@nx/nest:library": {
      "directory": "nest",
      "tags": "nest",
      "publishable": true
    },
    "@nx/angular:directive": {
      "standalone": true,
      "skipTests": true
    },
    "@nx/nest:application": {
      "e2eTestRunner": "none",
      "tags": "nest",
      "strict": true
    },
    "@nx/plugin:executor": {
      "unitTestRunner": "none"
    },
    "@nx/plugin:generator": {
      "unitTestRunner": "none"
    },
    "@nx/angular:library-secondary-entry-point": {
      "skipModule": true
    },
    "@nx/angular:host": {
      "style": "scss",
      "linter": "eslint",
      "unitTestRunner": "jest",
      "e2eTestRunner": "none",
      "tags": "angular,ngx",
      "prefix": "rxap",
      "standalone": true,
      "addTailwind": true,
      "name": "shell",
      "directory": "user-interface/shell"
    },
    "@nx/angular:remote": {
      "style": "scss",
      "linter": "eslint",
      "unitTestRunner": "jest",
      "e2eTestRunner": "none",
      "tags": "angular,ngx",
      "prefix": "rxap",
      "standalone": true,
      "addTailwind": true,
      "host": "shell",
      "directory": "user-interface/feature"
    }
  },
  "workspaceLayout": {
    "appsDir": "applications",
    "libsDir": "packages"
  },
  "cli": {
    "packageManager": "yarn"
  },
  "parallel": 6,
  "useInferencePlugins": false,
  "defaultBase": "development",
  "release": {
    "version": {
      "preVersionCommand": "yarn dlx nx run-many -t build"
    }
  },
  "useLegacyCache": true,
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      }
    },
    "./packages/plugin/library/src/plugin.ts",
    "./packages/plugin/angular/src/library.ts",
    "./packages/plugin/angular/src/application.ts",
    "./packages/plugin/nestjs/src/application.ts",
    "./packages/plugin/compodoc/src/plugin.ts",
    "./packages/plugin/typedoc/src/plugin.ts",
    "./packages/plugin/localazy/src/plugin.ts",
    "./packages/plugin/docker/src/plugin.ts",
    "./packages/plugin/web3-storage/src/plugin.ts",
    "./packages/plugin/kraft/src/plugin.ts",
    "./packages/plugin/workspace/src/plugin.ts"
  ]
}
