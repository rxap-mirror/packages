// Renovate configuration of this repository. The job runs here as a scheduled pipeline (.gitlab/ci/renovate.yml,
// RENOVATE.md). Supply-chain rules: UPGRADE-NOTES.md section 4.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':semanticCommits',
    // 7/14-day cooldown tiers by weekly downloads, generated by tools/scripts/renovate-tiers.mjs
    'local>rxap/packages:renovate-tiers',
  ],
  baseBranchPatterns: ['development'],
  timezone: 'Europe/Berlin',
  schedule: ['after 7pm every weekday', 'before 6am every weekday', 'every weekend'],
  labels: ['renovate'],
  dependencyDashboard: true,
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  // Docker images in CI files / Dockerfiles and the npm dependencies; our own CI components are bumped by hand
  enabledManagers: ['npm', 'gitlabci', 'dockerfile'],

  // --- release cooldown --------------------------------------------------------------------------------------
  // Default = strictest tier (30 days, also unknown popularity); renovate-tiers.json lowers it to 7/14 days.
  // strict: no branch at all before a release is old enough. CVE fixes wait as well (manual exceptions only).
  minimumReleaseAge: '30 days',
  internalChecksFilter: 'strict',
  vulnerabilityAlerts: {
    labels: ['renovate', 'security'],
  },

  // --- what Renovate touches -----------------------------------------------------------------------------------
  // Only the root manifest: tools/scripts/renovate-post-upgrade.mjs copies the ranges into the packages
  // (align-framework-dep-versions.mjs), and the cooldown pins in pnpm-workspace.yaml are written by our scripts.
  ignorePaths: ['**/node_modules/**', 'packages/**', 'demos/**', 'shared/**', 'applications/**', 'open-api/**', 'tools/**', 'tmp/**', 'dist/**', '.claude/**'],
  rangeStrategy: 'pin',
  postUpgradeTasks: {
    commands: ['node tools/scripts/renovate-post-upgrade.mjs'],
    fileFilters: ['**/package.json', 'pnpm-lock.yaml', 'pnpm-workspace.yaml', 'renovate-tiers.json'],
    executionMode: 'branch',
  },
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 6am on monday'],
    automerge: true,
  },

  packageRules: [
    // --- automerge: patch + minor after a green pipeline (supply-chain:check included), majors need approval ---
    {
      matchUpdateTypes: ['patch', 'minor', 'pin', 'digest'],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: true,
    },
    {
      matchUpdateTypes: ['major'],
      automerge: false,
      dependencyDashboardApproval: true,
      labels: ['renovate', 'major'],
    },

    // --- never touched by Renovate ---
    {
      description: 'pnpm-workspace.yaml overrides are cooldown / security pins written by our scripts (UPGRADE-NOTES.md section 4)',
      matchFileNames: ['pnpm-workspace.yaml'],
      enabled: false,
    },
    {
      description: 'engines states the supported runtime, it is not a version to update',
      matchDepTypes: ['engines'],
      enabled: false,
    },
    {
      description: 'our own CI components are bumped by hand',
      matchPackageNames: ['rxap/gitlab-ci', 'gitlab.com/rxap/gitlab-ci/**'],
      enabled: false,
    },

    // --- updated through nx migrate / the framework watch (Phase 5), never by Renovate ---
    {
      description: 'workspace packages',
      matchPackageNames: ['@rxap/**'],
      enabled: false,
    },
    {
      description: 'Angular: nx migrate',
      matchPackageNames: ['@angular/**', '@angular-devkit/**', '@schematics/angular', '@angular-eslint/**', 'zone.js', 'ng-packagr'],
      enabled: false,
    },
    {
      description: 'Nx: nx migrate',
      matchPackageNames: ['nx', '@nx/**', '@swc/**', '@swc-node/**'],
      enabled: false,
    },
    {
      description: 'NestJS: tools/scripts/update-nestjs-packages.sh (post-migrate)',
      matchPackageNames: ['@nestjs/**', 'cache-manager', 'class-transformer', 'class-validator', 'cookie-parser', '@types/cookie-parser', 'helmet', 'swagger-ui-express', 'csurf', '@types/csurf', 'express'],
      enabled: false,
    },

    // --- deliberately held back (UPGRADE-NOTES.md section 4, "Deliberately not at the newest major") ---
    { matchPackageNames: ['typescript'], allowedVersions: '<6.1', description: 'Angular 22 requires <6.1' },
    { matchPackageNames: ['@types/node'], allowedVersions: '<23', description: 'minimum supported Node runtime (22)' },
    { matchDatasources: ['docker'], matchPackageNames: ['node'], allowedVersions: '<23', description: 'CI images follow the supported Node runtime (22)' },
    { matchPackageNames: ['zod'], allowedVersions: '<4', description: '@langchain/* 0.3 and the litellm node require zod 3' },
    { matchPackageNames: ['tailwindcss'], allowedVersions: '<4', description: 'v4 is a migration' },
    { matchPackageNames: ['langchain', '@langchain/core', '@langchain/community'], allowedVersions: '<0.4', description: '@langchain/community 1.x is deprecated' },
    { matchPackageNames: ['@langchain/openai'], allowedVersions: '<0.7', description: 'langchain 0.3 line' },
    { matchPackageNames: ['@langchain/textsplitters'], allowedVersions: '<0.2', description: 'langchain 0.3 line' },
    { matchPackageNames: ['jsdom'], allowedVersions: '<27', description: '27+ is ESM-only for jest' },
    { matchPackageNames: ['webpack-dev-server'], allowedVersions: '<6', description: '@nx/webpack peer range' },
    { matchPackageNames: ['verdaccio'], allowedVersions: '<7', description: '@nx/js peer range' },
  ],
}
