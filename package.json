{
  "version": "0.0.0",
  "name": "@rxap/source",
  "description": "Reactive Application Platform, or RxAP for short, is a collection of software modules and tools. With the help of RxAP, the development effort of web and cloud applications can be significantly reduced.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "prepare": "husky install",
    "version": "env-cmd bash tools/scripts/lerna/hooks/version.sh",
    "preversion": "env-cmd bash tools/scripts/lerna/hooks/preversion.sh",
    "prepublishOnly": "env-cmd bash tools/scripts/lerna/hooks/prepublishOnly.sh | tee dist/lerna/prepublishOnly.log",
    "postpublish": "bash tools/scripts/lerna/hooks/postpublish.sh",
    "prepack": "bash tools/scripts/lerna/hooks/prepack.sh",
    "lerna:publish": "env-cmd bash tools/scripts/lerna/publish.sh",
    "lerna:version": "env-cmd bash tools/scripts/lerna/version.sh",
    "schematic": "bash tools/scripts/schematic.sh",
    "server": "bash tools/scripts/start-local-dev-services.sh",
    "server:status": "bash tools/scripts/get-local-dev-services-status.sh",
    "server:stop": "bash tools/scripts/stop-local-dev-services.sh",
    "generate:tls": "env-cmd bash ./docker/traefik/tls/generate.sh",
    "setup:local-deploy": "env-cmd bash ./docker/traefik/setup.sh",
    "webpack-bundle-analyzer": "webpack-bundle-analyzer",
    "init:env": "bash tools/scripts/setup-env-file.sh",
    "rxap:update": "npx npm-check-updates --filter /@rxap/ --target newest -u && yarn",
    "rxap:migrate": "yarn rxap:update && yarn rxap:compose",
    "rxap:compose": "yarn schematic @rxap/schematic-composer:compose",
    "post-migrate": "bash tools/scripts/post-migrate.sh"
  },
