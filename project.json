{
  "name": "workspace",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "targets": {
    "docker-gitlab-ci": {
      "executor": "@rxap/plugin-library:run-generator",
      "options": {
        "generator": "@rxap/plugin-docker:gitlab-ci",
        "withoutProjectArgument": true
      }
    },
    "init": {
      "executor": "@rxap/plugin-library:run-generator",
      "options": {
        "generator": "@rxap/plugin-library:init",
        "withoutProjectArgument": true
      }
    },
    "local-registry": {
      "executor": "@nx/js:verdaccio",
      "options": {
        "port": 4873,
        "config": ".verdaccio/config.yml",
        "storage": "tmp/local-registry/storage"
      }
    },
    "readme": {
      "executor": "workspace:readme"
    },
    "copy-docs-to-dist": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./tools/scripts/copy-to-dist.sh docs"
      }
    },
    "copy-compodoc-to-dist": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./tools/scripts/copy-to-dist.sh compodoc"
      }
    },
    "copy-coverage-to-dist": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./tools/scripts/copy-to-dist.sh coverage"
      }
    },
    "ci-info": {
      "dependsOn": [
        "copy-docs-to-dist",
        "copy-compodoc-to-dist",
        "copy-coverage-to-dist"
      ]
    },
    "compose": {
      "executor": "@rxap/plugin-library:run-generator",
      "options": {
        "generator": "@rxap/schematic-composer:compose",
        "withoutProjectArgument": true
      },
      "configurations": {
        "angular": {
          "options": {
            "project": "angular"
          }
        },
        "angular-table": {
          "options": {
            "project": "angular",
            "feature": "table"
          }
        }
      }
    },
    "docker-compose": {
      "executor": "@rxap/plugin-library:run-generator",
      "options": {
        "generator": "@rxap/plugin-workspace:docker-compose",
        "withoutProjectArgument": true,
        "options": {
          "ignoreProjects": [
            "service-configuration",
            "service-status",
            "service-user",
            "service-changelog"
          ]
        }
      }
    },
    "typedoc": {
      "outputs": ["{workspaceRoot}/docs"],
      "inputs": [
        "{workspaceRoot}/**/src/index.ts",
        "{workspaceRoot}/typedoc.json",
        "{workspaceRoot}/**/src/lib/**/*.ts",
        "!{workspaceRoot}/**/*.{spec,stories,cy}.ts",
        "!{workspaceRoot}/**/test-setup.ts"
      ]
    }
  }
}
