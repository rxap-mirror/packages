{
  "name": "workspace",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "targets": {
    "docker-gitlab-ci": {
      "executor": "@rxap/plugin-library:run-generator",
      "options": {
        "generator": "@rxap/plugin-docker:gitlab-ci",
        "withoutProjectArgument": true
      }
    },
    "init": {
      "executor": "@rxap/plugin-library:run-generator",
      "options": {
        "generator": "@rxap/plugin-library:init",
        "withoutProjectArgument": true
      }
    },
    "local-registry": {
      "executor": "@nx/js:verdaccio",
      "options": {
        "port": 4873,
        "config": ".verdaccio/config.yml",
        "storage": "tmp/local-registry/storage"
      }
    },
    "readme": {
      "executor": "workspace:readme"
    },
    "compose": {
      "executor": "@rxap/plugin-library:run-generator",
      "options": {
        "generator": "@rxap/schematic-composer:compose",
        "withoutProjectArgument": true
      },
      "configurations": {
        "angular": {
          "options": {
            "project": "angular"
          }
        },
        "angular-table": {
          "options": {
            "project": "angular",
            "feature": "table"
          }
        }
      }
    },
    "docker-compose": {
      "executor": "@rxap/plugin-library:run-generator",
      "options": {
        "generator": "@rxap/plugin-workspace:docker-compose",
        "withoutProjectArgument": true,
        "options": {
          "ignoreProjects": [
            "service-configuration",
            "service-status",
            "service-user",
            "service-changelog"
          ]
        }
      }
    }
  }
}
