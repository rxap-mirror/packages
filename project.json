{
  "name": "workspace",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "targets": {
    "docker-gitlab-ci": {
      "executor": "@rxap/plugin-library:run-generator",
      "options": {
        "generator": "@rxap/plugin-docker:gitlab-ci",
        "withoutProjectArgument": true
      }
    },
    "init": {
      "executor": "@rxap/plugin-library:run-generator",
      "options": {
        "generator": "@rxap/plugin-library:init",
        "withoutProjectArgument": true
      }
    },
    "local-registry": {
      "executor": "@nx/js:verdaccio",
      "options": {
        "port": 4873,
        "config": ".verdaccio/config.yml",
        "storage": "tmp/local-registry/storage"
      }
    },
    "readme": {
      "executor": "workspace:readme"
    },
    "compose": {
      "executor": "@rxap/plugin-library:run-generator",
      "options": {
        "generator": "@rxap/schematic-composer:compose",
        "withoutProjectArgument": true
      },
      "configurations": {
        "angular": {
          "options": {
            "project": "angular"
          }
        },
        "angular-table": {
          "options": {
            "project": "angular",
            "feature": "table"
          }
        }
      }
    },
    "docker-compose": {
      "executor": "@rxap/plugin-library:run-generator",
      "options": {
        "generator": "@rxap/plugin-workspace:docker-compose",
        "withoutProjectArgument": true,
        "options": {
          "ignoreProjects": [
            "service-configuration",
            "service-status",
            "service-user",
            "service-changelog"
          ]
        }
      }
    },
    "typedoc": {
      "options": {
        "entryPoints": [
          "packages/angular/authentication/src/index.ts",
          "packages/angular/authorization/src/index.ts",
          "packages/angular/bootstrap/src/index.ts",
          "packages/angular/changelog/src/index.ts",
          "packages/angular/components/src/index.ts",
          "packages/angular/config/src/index.ts",
          "packages/angular/contenteditable/src/index.ts",
          "packages/angular/data-grid/src/index.ts",
          "packages/angular/data-source/src/index.ts",
          "packages/angular/definition/src/index.ts",
          "packages/angular/dialog/src/index.ts",
          "packages/angular/directives/src/index.ts",
          "packages/angular/environment/src/index.ts",
          "packages/angular/error/src/index.ts",
          "packages/angular/firebase/src/index.ts",
          "packages/angular/form-system/src/index.ts",
          "packages/angular/form-window-system/src/index.ts",
          "packages/angular/forms/src/index.ts",
          "packages/angular/handlebars/src/index.ts",
          "packages/angular/icon/src/index.ts",
          "packages/angular/keycloak/src/index.ts",
