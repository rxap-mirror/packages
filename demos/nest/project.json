{
  "name": "service-nest",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "demos/nest/src",
  "projectType": "application",
  "tags": [
    "nest",
    "service",
    "application",
    "backend",
    "sentry",
    "swagger",
    "health-indicator",
    "express",
    "demo"
  ],
  "targets": {
    "build": {
      "dependsOn": [
        "^build",
        "^index-export",
        "index-export",
        "generate-package-json"
      ],
      "outputs": ["{workspaceRoot}/dist/demos/nest"],
      "defaultConfiguration": "production",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "service-nest:build:development",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "service-nest:build:development"
        },
        "production": {
          "buildTarget": "service-nest:build:production"
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "docker": {
      "options": {
        "imageSuffix": "/service-nest",
        "buildArgList": [
          "PATH_PREFIX=REGEX:app/app.config.ts:validationSchema\\['GLOBAL_API_PREFIX'\\]\\s*=\\s*Joi.string\\(\\).default\\(\\s*'(.+)',?\\s*\\);"
        ]
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "docker-save": {}
  }
}
